<!-- Skip Link for Accessibility -->
<a href="#main-content" class="skip-link">Skip to main content</a>

<!-- Clean Airbnb-style Navigation -->
<header class="fixed top-0 left-0 right-0 z-50 bg-white border-b border-gray-200" id="mainNav" role="banner">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8" role="navigation" aria-label="Main navigation">
    <!-- Desktop Navigation -->
    <div class="hidden md:flex md:justify-between md:items-center h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 hover:opacity-80 transition">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 36 40" class="w-9 h-10" fill="none">
          <path d="M18 0C8.06 0 0 8.06 0 18c0 9.94 18 22 18 22s18-12.06 18-22C36 8.06 27.94 0 18 0z" fill="#FF385C"/>
          <path d="M18 8l-9 7v10h6v-6h6v6h6V15l-9-7z" fill="white"/>
          <rect x="16" y="19" width="4" height="6" rx="0.5" fill="#FF385C"/>
        </svg>
        <span class="text-xl font-bold"><span class="text-rose-500">stay</span><span class="text-gray-800">bnb</span></span>
      </a>

      <!-- Center Navigation Links -->
      <div class="flex items-center space-x-1">
        <% if (isLoggedIn) { %>
          <% if (user && user.userType === 'guest') { %>
            <a href="/homes" class="px-4 py-2.5 text-sm font-medium text-gray-800 hover:bg-gray-100 rounded-full transition <%= currentPage === 'Home' ? 'bg-gray-100' : '' %>">
              Explore
            </a>
            <a href="/favourites" class="px-4 py-2.5 text-sm font-medium text-gray-800 hover:bg-gray-100 rounded-full transition <%= currentPage === 'favourites' ? 'bg-gray-100' : '' %>">
              Wishlists
            </a>
            <a href="/bookings/my" class="px-4 py-2.5 text-sm font-medium text-gray-800 hover:bg-gray-100 rounded-full transition <%= currentPage === 'bookings' ? 'bg-gray-100' : '' %>">
              Trips
            </a>
          <% } else { %>
            <a href="/host/host-home-list" class="px-4 py-2.5 text-sm font-medium text-gray-800 hover:bg-gray-100 rounded-full transition <%= currentPage === 'host-homes' ? 'bg-gray-100' : '' %>">
              Listings
            </a>
            <a href="/host/add-home" class="px-4 py-2.5 text-sm font-medium text-gray-800 hover:bg-gray-100 rounded-full transition <%= currentPage === 'addHome' ? 'bg-gray-100' : '' %>">
              Add Listing
            </a>
            <a href="/pricing/rules" class="px-4 py-2.5 text-sm font-medium text-gray-800 hover:bg-gray-100 rounded-full transition <%= currentPage === 'pricing' ? 'bg-gray-100' : '' %>">
              Pricing
            </a>
          <% } %>
        <% } else { %>
          <a href="/homes" class="px-4 py-2.5 text-sm font-medium text-gray-800 hover:bg-gray-100 rounded-full transition">
            Stays
          </a>
        <% } %>
      </div>

      <!-- Right Side - Auth/User Menu -->
      <div class="flex items-center space-x-4">
        <% if (!isLoggedIn) { %>
          <a href="/host/add-home" class="text-sm font-medium text-gray-800 hover:bg-gray-100 px-4 py-2 rounded-full transition">
            Become a Host
          </a>
          <a href="/login" class="flex items-center space-x-2 px-3 py-2 border border-gray-300 rounded-full hover:shadow-md transition">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-gray-600">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"/>
            </svg>
            <div class="w-8 h-8 bg-gray-500 rounded-full flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white" class="w-5 h-5">
                <path fill-rule="evenodd" d="M7.5 6a4.5 4.5 0 119 0 4.5 4.5 0 01-9 0zM3.751 20.105a8.25 8.25 0 0116.498 0 .75.75 0 01-.437.695A18.683 18.683 0 0112 22.5c-2.786 0-5.433-.608-7.812-1.7a.75.75 0 01-.437-.695z" clip-rule="evenodd"/>
              </svg>
            </div>
          </a>
        <% } else { %>
          <!-- User Menu -->
          <div class="relative" id="userDropdown">
            <button class="flex items-center space-x-2 px-3 py-2 border border-gray-300 rounded-full hover:shadow-md transition" id="userMenuBtn">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-gray-600">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"/>
              </svg>
              <div class="w-8 h-8 bg-gray-700 rounded-full flex items-center justify-center text-white text-sm font-medium">
                <%= user.firstName ? user.firstName.charAt(0).toUpperCase() : 'U' %>
              </div>
            </button>
            
            <!-- Dropdown Menu -->
            <div class="hidden absolute right-0 top-full mt-2 w-60 bg-white rounded-xl shadow-lg border border-gray-200 py-2 z-50" id="userMenu">
                <div class="px-4 py-3 border-b border-gray-100">
                  <p class="text-sm font-semibold text-gray-900"><%= user.firstName || user.email.split('@')[0] %> <%= user.lastName || '' %></p>
                  <p class="text-xs text-gray-500 capitalize"><%= user.userType || 'guest' %> Account</p>
                </div>
                
                <a href="/profile" class="dropdown-item">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                  </svg>
                  My Profile
                </a>
                
                <% if (user && user.userType === 'guest') { %>
                  <a href="/bookings/my" class="dropdown-item">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                    My Trips
                  </a>
                  <a href="/favourites" class="dropdown-item">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                    </svg>
                    Wishlist
                  </a>
                <% } else { %>
                  <a href="/host/host-home-list" class="dropdown-item">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                    </svg>
                    My Listings
                  </a>
                  <a href="/pricing/rules" class="dropdown-item">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    Dynamic Pricing
                  </a>
                <% } %>
                
                <div class="border-t border-gray-100 mt-2 pt-2">
                  <a href="/profile/change-password" class="dropdown-item text-gray-600">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                    </svg>
                    Change Password
                  </a>
                  <form action="/logout" method="POST">
                    <button type="submit" class="dropdown-item w-full text-left text-rose-600 hover:bg-rose-50">
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                      </svg>
                      Log out
                    </button>
                  </form>
                </div>
              </div>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Mobile Navigation -->
      <div class="md:hidden">
        <div class="flex justify-between items-center h-16 px-4">
          <a href="/" class="flex items-center gap-1.5 hover:opacity-80 transition">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 36 40" class="w-7 h-8" fill="none">
              <path d="M18 0C8.06 0 0 8.06 0 18c0 9.94 18 22 18 22s18-12.06 18-22C36 8.06 27.94 0 18 0z" fill="#FF385C"/>
              <path d="M18 8l-9 7v10h6v-6h6v6h6V15l-9-7z" fill="white"/>
              <rect x="16" y="19" width="4" height="6" rx="0.5" fill="#FF385C"/>
            </svg>
            <span class="text-lg font-bold"><span class="text-rose-500">stay</span><span class="text-gray-800">bnb</span></span>
          </a>

          <button id="mobileMenuBtn" class="p-2 rounded-full hover:bg-gray-100 transition">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6 text-gray-700">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"/>
            </svg>
          </button>
        </div>

        <!-- Mobile Menu Overlay -->
        <div id="mobileMenu" class="hidden fixed inset-0 bg-black/30 z-50">
          <div class="absolute right-0 top-0 h-full w-80 bg-white shadow-xl">
            <div class="p-4 border-b border-gray-100">
              <div class="flex justify-between items-center">
                <span class="font-semibold text-lg text-gray-900">Menu</span>
                <button id="closeMobileMenu" class="p-2 hover:bg-gray-100 rounded-full transition">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 text-gray-600">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                  </svg>
                </button>
              </div>
              <% if (isLoggedIn) { %>
                <div class="mt-4 flex items-center space-x-3">
                  <div class="w-12 h-12 rounded-full bg-gray-700 flex items-center justify-center text-white font-medium text-lg">
                    <%= user.firstName ? user.firstName.charAt(0).toUpperCase() : 'U' %>
                  </div>
                  <div>
                    <p class="font-medium text-gray-900"><%= user.firstName || user.email.split('@')[0] %></p>
                    <p class="text-sm text-gray-500 capitalize"><%= user.userType %></p>
                  </div>
                </div>
              <% } %>
            </div>
            
            <nav class="p-4">
              <% if (!isLoggedIn) { %>
                <a href="/login" class="mobile-nav-item font-medium">Log in</a>
                <a href="/signup" class="mobile-nav-item">Sign up</a>
                <div class="border-t border-gray-100 my-3"></div>
                <a href="/homes" class="mobile-nav-item">Explore</a>
              <% } else { %>
                <% if (user && user.userType === 'guest') { %>
                  <a href="/homes" class="mobile-nav-item">Explore</a>
                  <a href="/favourites" class="mobile-nav-item">Wishlists</a>
                  <a href="/bookings/my" class="mobile-nav-item">Trips</a>
                <% } else { %>
                  <a href="/host/host-home-list" class="mobile-nav-item">Listings</a>
                  <a href="/host/add-home" class="mobile-nav-item">Add Listing</a>
                  <a href="/pricing/rules" class="mobile-nav-item">Pricing</a>
                <% } %>
                
                <div class="border-t border-gray-100 my-3"></div>
                <a href="/profile" class="mobile-nav-item">Account</a>
                <form action="/logout" method="POST">
                  <button type="submit" class="mobile-nav-item w-full text-left">Log out</button>
                </form>
              <% } %>
            </nav>
          </div>
        </div>
      </div>
    </div>
  </nav>
</header>

<!-- Spacer for fixed nav - responsive height -->
<div class="h-16 md:h-20"></div>

<!-- Navigation Styles -->
<style>
  /* Skip link for accessibility */
  .skip-link {
    position: absolute;
    top: -40px;
    left: 0;
    background: #000;
    color: #fff;
    padding: 8px 16px;
    z-index: 100;
    transition: top 0.3s;
  }
  .skip-link:focus {
    top: 0;
  }
  
  .dropdown-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 16px;
    font-size: 14px;
    color: #222;
    transition: background 0.2s;
  }
  .dropdown-item:hover {
    background: #f7f7f7;
  }
  .mobile-nav-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    color: #222;
    border-radius: 8px;
    transition: background 0.2s;
  }
  .mobile-nav-item:hover {
    background: #f7f7f7;
  }
  
  /* Mobile menu animation */
  @media (max-width: 767px) {
    #mobileMenu > div {
      transform: translateX(100%);
      transition: transform 0.3s ease-out;
    }
    #mobileMenu:not(.hidden) > div {
      transform: translateX(0);
    }
  }
</style>

<!-- Navigation Scripts -->
<script>
  // Desktop dropdown
  const userMenuBtn = document.getElementById('userMenuBtn');
  const userMenu = document.getElementById('userMenu');
  
  if (userMenuBtn && userMenu) {
    userMenuBtn.addEventListener('click', () => {
      userMenu.classList.toggle('hidden');
    });
    
    document.addEventListener('click', (e) => {
      if (!document.getElementById('userDropdown')?.contains(e.target)) {
        userMenu.classList.add('hidden');
      }
    });
  }
  
  // Mobile menu
  const mobileMenuBtn = document.getElementById('mobileMenuBtn');
  const mobileMenu = document.getElementById('mobileMenu');
  const closeMobileMenu = document.getElementById('closeMobileMenu');
  
  if (mobileMenuBtn && mobileMenu) {
    mobileMenuBtn.addEventListener('click', () => {
      mobileMenu.classList.remove('hidden');
    });
    
    closeMobileMenu?.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
    });
    
    mobileMenu.addEventListener('click', (e) => {
      if (e.target === mobileMenu) {
        mobileMenu.classList.add('hidden');
      }
    });
  }
  
  // Scroll effect for nav
  const mainNav = document.getElementById('mainNav');
  
  window.addEventListener('scroll', () => {
    if (window.pageYOffset > 0) {
      mainNav.classList.remove('border-b');
      mainNav.classList.add('shadow-sm');
    } else {
      mainNav.classList.add('border-b');
      mainNav.classList.remove('shadow-sm');
    }
  });
</script>
