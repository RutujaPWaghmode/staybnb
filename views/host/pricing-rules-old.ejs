<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
  <title><%= pageTitle %></title>
</head>
<body class="bg-gray-50 min-h-screen">
  <%- include('../partials/nav') %>
  
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="mb-8 flex justify-between items-center">
      <div>
        <h1 class="text-3xl font-bold text-gray-900">Dynamic Pricing Rules</h1>
        <p class="mt-2 text-gray-600">Manage price adjustments for weekends, holidays, seasons, and more.</p>
      </div>
      <div class="flex space-x-3">
        <form action="/pricing/seed" method="POST" class="inline">
          <button type="submit" class="px-4 py-2 bg-gray-600 text-white rounded-lg hover:bg-gray-700 transition">
            Seed Defaults
          </button>
        </form>
        <a href="/pricing/rules/new" class="px-4 py-2 bg-rose-600 text-white rounded-lg hover:bg-rose-700 transition">
          + New Rule
        </a>
      </div>
    </div>
    
    <% if (successMessage) { %>
      <div class="mb-6 p-4 bg-green-100 text-green-800 rounded-lg border border-green-200">
        <%= successMessage %>
      </div>
    <% } %>
    
    <!-- Pricing Rules Legend -->
    <div class="mb-6 bg-white rounded-lg shadow p-4">
      <h3 class="text-sm font-semibold text-gray-700 mb-3">Rule Types</h3>
      <div class="flex flex-wrap gap-2">
        <span class="px-2 py-1 text-xs rounded bg-purple-100 text-purple-800">WEEKEND</span>
        <span class="px-2 py-1 text-xs rounded bg-red-100 text-red-800">HOLIDAY</span>
        <span class="px-2 py-1 text-xs rounded bg-orange-100 text-orange-800">SEASONAL</span>
        <span class="px-2 py-1 text-xs rounded bg-blue-100 text-blue-800">CUSTOM</span>
        <span class="px-2 py-1 text-xs rounded bg-yellow-100 text-yellow-800">LAST_MINUTE</span>
        <span class="px-2 py-1 text-xs rounded bg-green-100 text-green-800">EARLY_BIRD</span>
      </div>
    </div>
    
    <!-- Pricing Rules Table -->
    <div class="bg-white rounded-lg shadow overflow-hidden">
      <% if (rules.length === 0) { %>
        <div class="p-8 text-center text-gray-500">
          <svg class="w-16 h-16 mx-auto mb-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <p class="text-lg font-medium">No pricing rules yet</p>
          <p class="mt-2">Create your first rule or seed the default rules to get started.</p>
        </div>
      <% } else { %>
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Rule</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Type</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Adjustment</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Priority</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
              <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Actions</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% rules.forEach(rule => { %>
              <tr class="hover:bg-gray-50 <%= !rule.isActive ? 'opacity-50' : '' %>">
                <td class="px-6 py-4">
                  <div class="font-medium text-gray-900"><%= rule.name %></div>
                  <div class="text-sm text-gray-500"><%= rule.description || 'No description' %></div>
                  <div class="text-xs text-gray-400 mt-1">
                    <span class="<%= rule.scope === 'GLOBAL' ? 'text-blue-600' : 'text-green-600' %>">
                      <%= rule.scope %>
                    </span>
                    <% if (rule.stackable) { %>
                      • <span class="text-purple-600">Stackable</span>
                    <% } %>
                  </div>
                </td>
                <td class="px-6 py-4">
                  <span class="px-2 py-1 text-xs rounded 
                    <% if (rule.type === 'WEEKEND') { %>bg-purple-100 text-purple-800
                    <% } else if (rule.type === 'HOLIDAY') { %>bg-red-100 text-red-800
                    <% } else if (rule.type === 'SEASONAL') { %>bg-orange-100 text-orange-800
                    <% } else if (rule.type === 'CUSTOM') { %>bg-blue-100 text-blue-800
                    <% } else if (rule.type === 'LAST_MINUTE') { %>bg-yellow-100 text-yellow-800
                    <% } else if (rule.type === 'EARLY_BIRD') { %>bg-green-100 text-green-800
                    <% } else { %>bg-gray-100 text-gray-800<% } %>">
                    <%= rule.type %>
                  </span>
                </td>
                <td class="px-6 py-4">
                  <span class="<%= rule.displayAdjustment.includes('-') ? 'text-green-600' : 'text-red-600' %> font-medium">
                    <%= rule.displayAdjustment.includes('-') ? '' : '+' %><%= rule.displayAdjustment %>
                  </span>
                </td>
                <td class="px-6 py-4 text-gray-600"><%= rule.priority %></td>
                <td class="px-6 py-4">
                  <form action="/pricing/rules/<%= rule.id %>/toggle" method="POST" class="inline">
                    <button type="submit" class="px-2 py-1 text-xs rounded <%= rule.isActive ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-600' %>">
                      <%= rule.isActive ? 'Active' : 'Inactive' %>
                    </button>
                  </form>
                </td>
                <td class="px-6 py-4 text-right space-x-2">
                  <a href="/pricing/rules/<%= rule.id %>/edit" class="text-blue-600 hover:text-blue-800 text-sm">Edit</a>
                  <form action="/pricing/rules/<%= rule.id %>/delete" method="POST" class="inline" onsubmit="return confirm('Delete this rule?');">
                    <button type="submit" class="text-red-600 hover:text-red-800 text-sm">Delete</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
    
    <!-- Pricing Algorithm Info -->
    <div class="mt-8 bg-blue-50 rounded-lg p-6 border border-blue-100">
      <h3 class="text-lg font-semibold text-blue-900 mb-3">How Dynamic Pricing Works</h3>
      <div class="grid md:grid-cols-2 gap-4 text-sm text-blue-800">
        <div>
          <h4 class="font-medium mb-1">Rule Priority</h4>
          <p>Higher priority rules take precedence. Non-stackable rules override lower priority rules.</p>
        </div>
        <div>
          <h4 class="font-medium mb-1">Multiplicative Stacking</h4>
          <p>Stackable rules compound: base × rule1 × rule2. E.g., Weekend (1.15) × Holiday (1.25) = 1.4375</p>
        </div>
        <div>
          <h4 class="font-medium mb-1">Daily Calculation</h4>
          <p>Each night is priced independently based on which rules apply to that specific date.</p>
        </div>
        <div>
          <h4 class="font-medium mb-1">Global vs Listing</h4>
          <p>Global rules apply to all listings. Listing-specific rules only affect that property.</p>
        </div>
      </div>
    </div>
  </main>
</body>
</html>
