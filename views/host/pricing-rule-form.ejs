<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
  <title><%= pageTitle %></title>
</head>
<body class="bg-gray-50 min-h-screen">
  <%- include('../partials/nav') %>
  
  <main class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="mb-8">
      <a href="/pricing/rules" class="text-rose-600 hover:text-rose-700 text-sm mb-4 inline-block">
        ← Back to Rules
      </a>
      <h1 class="text-3xl font-bold text-gray-900"><%= pageTitle %></h1>
    </div>
    
    <% if (errors.length > 0) { %>
      <div class="mb-6 p-4 bg-red-50 text-red-800 rounded-lg border border-red-200">
        <% errors.forEach(error => { %>
          <p><%= error %></p>
        <% }) %>
      </div>
    <% } %>
    
    <form action="<%= rule ? '/pricing/rules/' + rule._id : '/pricing/rules' %>" method="POST" class="bg-white rounded-lg shadow p-6 space-y-6">
      
      <!-- Basic Info -->
      <div class="border-b pb-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Basic Information</h2>
        
        <div class="grid gap-4">
          <div>
            <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Rule Name *</label>
            <input type="text" id="name" name="name" required
              value="<%= rule ? rule.name : '' %>"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-rose-500 focus:border-rose-500"
              placeholder="e.g., Weekend Premium">
          </div>
          
          <div>
            <label for="description" class="block text-sm font-medium text-gray-700 mb-1">Description</label>
            <textarea id="description" name="description" rows="2"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-rose-500 focus:border-rose-500"
              placeholder="Describe when and why this rule applies"><%= rule ? rule.description : '' %></textarea>
          </div>
        </div>
      </div>
      
      <!-- Rule Type -->
      <div class="border-b pb-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Rule Type</h2>
        
        <div class="grid md:grid-cols-3 gap-3">
          <% ruleTypes.forEach(type => { %>
            <label class="relative flex cursor-pointer rounded-lg border p-4 hover:bg-gray-50 <%= rule && rule.ruleType === type ? 'border-rose-500 bg-rose-50' : 'border-gray-200' %>">
              <input type="radio" name="ruleType" value="<%= type %>" class="sr-only" 
                <%= (!rule && type === 'WEEKEND') || (rule && rule.ruleType === type) ? 'checked' : '' %>>
              <div>
                <span class="block text-sm font-medium text-gray-900"><%= type %></span>
                <span class="block text-xs text-gray-500 mt-1">
                  <% if (type === 'WEEKEND') { %>Fri-Sun pricing<% } %>
                  <% if (type === 'HOLIDAY') { %>Specific holidays<% } %>
                  <% if (type === 'SEASONAL') { %>Date ranges<% } %>
                  <% if (type === 'CUSTOM') { %>Custom dates<% } %>
                  <% if (type === 'LAST_MINUTE') { %>Near check-in<% } %>
                  <% if (type === 'EARLY_BIRD') { %>Far in advance<% } %>
                </span>
              </div>
            </label>
          <% }) %>
        </div>
      </div>
      
      <!-- Scope -->
      <div class="border-b pb-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Rule Scope</h2>
        
        <div class="flex space-x-4 mb-4">
          <label class="flex items-center">
            <input type="radio" name="scope" value="GLOBAL" class="text-rose-600 mr-2"
              <%= !rule || rule.scope === 'GLOBAL' ? 'checked' : '' %>>
            <span class="text-gray-700">Global (all listings)</span>
          </label>
          <label class="flex items-center">
            <input type="radio" name="scope" value="LISTING" class="text-rose-600 mr-2"
              <%= rule && rule.scope === 'LISTING' ? 'checked' : '' %>>
            <span class="text-gray-700">Specific Listing</span>
          </label>
        </div>
        
        <div id="listingSelect" class="<%= !rule || rule.scope === 'GLOBAL' ? 'hidden' : '' %>">
          <select name="listingId" class="w-full px-4 py-2 border border-gray-300 rounded-lg">
            <option value="">Select a listing</option>
            <% homes.forEach(home => { %>
              <option value="<%= home._id %>" <%= rule && rule.listingId && rule.listingId.toString() === home._id.toString() ? 'selected' : '' %>>
                <%= home.houseName %>
              </option>
            <% }) %>
          </select>
        </div>
      </div>
      
      <!-- Price Adjustment -->
      <div class="border-b pb-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Price Adjustment</h2>
        
        <div class="grid md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Adjustment Type</label>
            <select name="adjustmentType" class="w-full px-4 py-2 border border-gray-300 rounded-lg">
              <option value="PERCENTAGE" <%= !rule || rule.adjustmentType === 'PERCENTAGE' ? 'selected' : '' %>>Percentage (%)</option>
              <option value="FIXED" <%= rule && rule.adjustmentType === 'FIXED' ? 'selected' : '' %>>Fixed Amount (₹)</option>
            </select>
          </div>
          
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Adjustment Value *</label>
            <input type="number" name="adjustmentValue" step="0.01" required
              value="<%= rule ? rule.displayAdjustment : '15' %>"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg"
              placeholder="e.g., 15 for +15%">
            <p class="text-xs text-gray-500 mt-1">Enter positive for increase, negative for discount (e.g., -10 for 10% off)</p>
          </div>
        </div>
      </div>
      
      <!-- Type-Specific Options -->
      <div class="border-b pb-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Rule Configuration</h2>
        
        <!-- Weekend Days -->
        <div id="weekendConfig" class="mb-4">
          <label class="block text-sm font-medium text-gray-700 mb-2">Days of Week (for WEEKEND type)</label>
          <div class="flex flex-wrap gap-2">
            <% ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].forEach((day, i) => { %>
              <label class="flex items-center px-3 py-1 border rounded-lg cursor-pointer hover:bg-gray-50">
                <input type="checkbox" name="daysOfWeek" value="<%= i %>" class="mr-2"
                  <%= (!rule && (i === 0 || i === 5 || i === 6)) || (rule && rule.daysOfWeek && rule.daysOfWeek.includes(i)) ? 'checked' : '' %>>
                <span class="text-sm"><%= day %></span>
              </label>
            <% }) %>
          </div>
        </div>
        
        <!-- Date Range (for SEASONAL, CUSTOM) -->
        <div id="dateRangeConfig" class="mb-4">
          <label class="block text-sm font-medium text-gray-700 mb-2">Date Range (for SEASONAL, CUSTOM)</label>
          <div class="grid md:grid-cols-2 gap-4">
            <div>
              <label class="text-xs text-gray-500">Start Date</label>
              <input type="date" name="startDate" 
                value="<%= rule && rule.startDate ? new Date(rule.startDate).toISOString().split('T')[0] : '' %>"
                class="w-full px-4 py-2 border border-gray-300 rounded-lg">
            </div>
            <div>
              <label class="text-xs text-gray-500">End Date</label>
              <input type="date" name="endDate" 
                value="<%= rule && rule.endDate ? new Date(rule.endDate).toISOString().split('T')[0] : '' %>"
                class="w-full px-4 py-2 border border-gray-300 rounded-lg">
            </div>
          </div>
          <label class="flex items-center mt-2">
            <input type="checkbox" name="recurring" class="mr-2" <%= rule && rule.recurring ? 'checked' : '' %>>
            <span class="text-sm text-gray-600">Recurring (repeat every year)</span>
          </label>
        </div>
        
        <!-- Advance Days (for LAST_MINUTE, EARLY_BIRD) -->
        <div id="advanceDaysConfig" class="grid md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Days Before Check-in (LAST_MINUTE)</label>
            <input type="number" name="daysBeforeCheckIn" min="1" 
              value="<%= rule && rule.daysBeforeCheckIn ? rule.daysBeforeCheckIn : '' %>"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg"
              placeholder="e.g., 3">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Days in Advance (EARLY_BIRD)</label>
            <input type="number" name="daysInAdvance" min="1" 
              value="<%= rule && rule.daysInAdvance ? rule.daysInAdvance : '' %>"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg"
              placeholder="e.g., 30">
          </div>
        </div>
      </div>
      
      <!-- Priority and Stacking -->
      <div class="border-b pb-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Priority & Stacking</h2>
        
        <div class="grid md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Priority (1-100)</label>
            <input type="number" name="priority" min="1" max="100"
              value="<%= rule ? rule.priority : '10' %>"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg">
            <p class="text-xs text-gray-500 mt-1">Higher = more important</p>
          </div>
          
          <div class="flex items-center">
            <label class="flex items-center">
              <input type="checkbox" name="stackable" class="mr-2 h-5 w-5 text-rose-600"
                <%= !rule || rule.stackable ? 'checked' : '' %>>
              <span class="text-gray-700">Stackable (combine with other rules)</span>
            </label>
          </div>
        </div>
      </div>
      
      <% if (rule) { %>
      <!-- Active Status (only for edit) -->
      <div class="border-b pb-6">
        <label class="flex items-center">
          <input type="checkbox" name="isActive" class="mr-2 h-5 w-5 text-rose-600"
            <%= rule.isActive ? 'checked' : '' %>>
          <span class="text-gray-700 font-medium">Active</span>
        </label>
      </div>
      <% } %>
      
      <!-- Submit -->
      <div class="flex justify-end space-x-4">
        <a href="/pricing/rules" class="px-6 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50">
          Cancel
        </a>
        <button type="submit" class="px-6 py-2 bg-rose-600 text-white rounded-lg hover:bg-rose-700">
          <%= rule ? 'Update Rule' : 'Create Rule' %>
        </button>
      </div>
    </form>
  </main>
  
  <script>
    // Toggle listing select based on scope
    document.querySelectorAll('input[name="scope"]').forEach(radio => {
      radio.addEventListener('change', function() {
        const listingSelect = document.getElementById('listingSelect');
        if (this.value === 'LISTING') {
          listingSelect.classList.remove('hidden');
        } else {
          listingSelect.classList.add('hidden');
        }
      });
    });
    
    // Visual feedback for rule type selection
    document.querySelectorAll('input[name="ruleType"]').forEach(radio => {
      radio.addEventListener('change', function() {
        document.querySelectorAll('input[name="ruleType"]').forEach(r => {
          r.closest('label').classList.remove('border-rose-500', 'bg-rose-50');
          r.closest('label').classList.add('border-gray-200');
        });
        this.closest('label').classList.remove('border-gray-200');
        this.closest('label').classList.add('border-rose-500', 'bg-rose-50');
      });
    });
  </script>
</body>
</html>
