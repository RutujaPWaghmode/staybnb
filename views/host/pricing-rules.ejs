<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
  <title><%= pageTitle %></title>
</head>
<body class="bg-gray-50 min-h-screen">
  <%- include('../partials/nav') %>
  
  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900">Dynamic Pricing</h1>
      <p class="mt-2 text-gray-600">Automatic price adjustments based on demand and seasonality.</p>
    </div>
    
    <!-- Active Rules Banner -->
    <% if (activeRules && activeRules.length > 0) { %>
      <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-xl">
        <div class="flex items-center gap-2 mb-2">
          <svg class="w-5 h-5 text-green-600" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
          </svg>
          <span class="font-semibold text-green-800">Currently Active Rules</span>
        </div>
        <div class="flex flex-wrap gap-2">
          <% activeRules.forEach(rule => { %>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium 
              <% if (rule.type === 'WEEKEND') { %>bg-purple-100 text-purple-800
              <% } else if (rule.type === 'FESTIVE') { %>bg-rose-100 text-rose-800
              <% } else if (rule.type === 'OFFSEASON') { %>bg-blue-100 text-blue-800
              <% } else { %>bg-gray-100 text-gray-800<% } %>">
              <span class="w-2 h-2 rounded-full mr-2 
                <% if (rule.type === 'WEEKEND') { %>bg-purple-500
                <% } else if (rule.type === 'FESTIVE') { %>bg-rose-500
                <% } else if (rule.type === 'OFFSEASON') { %>bg-blue-500
                <% } else { %>bg-gray-500<% } %>"></span>
              <%= rule.name %> (<%= rule.displayAdjustment %>)
            </span>
          <% }) %>
        </div>
      </div>
    <% } else { %>
      <div class="mb-6 p-4 bg-gray-50 border border-gray-200 rounded-xl">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-gray-500" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd"/>
          </svg>
          <span class="text-gray-600">No pricing rules active today. Base prices apply to all bookings.</span>
        </div>
      </div>
    <% } %>
    
    <!-- Pricing Rules Cards -->
    <div class="space-y-4">
      <% rules.forEach(rule => { %>
        <div class="bg-white rounded-xl shadow-sm border <%= rule.isActive ? 'border-green-300 ring-1 ring-green-100' : 'border-gray-200' %> overflow-hidden">
          <div class="p-6">
            <div class="flex items-start justify-between">
              <div class="flex items-start gap-4">
                <!-- Rule Icon -->
                <div class="flex-shrink-0 w-12 h-12 rounded-xl flex items-center justify-center
                  <% if (rule.type === 'WEEKEND') { %>bg-purple-100
                  <% } else if (rule.type === 'FESTIVE') { %>bg-rose-100
                  <% } else if (rule.type === 'OFFSEASON') { %>bg-blue-100
                  <% } else { %>bg-gray-100<% } %>">
                  <% if (rule.type === 'WEEKEND') { %>
                    <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                  <% } else if (rule.type === 'FESTIVE') { %>
                    <svg class="w-6 h-6 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
                    </svg>
                  <% } else if (rule.type === 'OFFSEASON') { %>
                    <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                  <% } %>
                </div>
                
                <!-- Rule Info -->
                <div>
                  <div class="flex items-center gap-2">
                    <h3 class="text-lg font-semibold text-gray-900"><%= rule.name %></h3>
                    <% if (rule.isActive) { %>
                      <span class="px-2 py-0.5 text-xs font-medium bg-green-100 text-green-800 rounded-full">
                        Active Now
                      </span>
                    <% } %>
                  </div>
                  <p class="mt-1 text-gray-600"><%= rule.description %></p>
                  <div class="mt-3 flex flex-wrap gap-2 text-sm">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-md bg-gray-100 text-gray-700">
                      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                      </svg>
                      <%= rule.scope %> - All Properties
                    </span>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-md bg-gray-100 text-gray-700">
                      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                      </svg>
                      <%= rule.condition %>
                    </span>
                  </div>
                </div>
              </div>
              
              <!-- Price Adjustment -->
              <div class="text-right">
                <div class="text-2xl font-bold 
                  <% if (rule.type === 'OFFSEASON') { %>text-green-600
                  <% } else { %>text-rose-600<% } %>">
                  <%= rule.displayAdjustment %>
                </div>
                <div class="text-sm text-gray-500">
                  <%= rule.type === 'OFFSEASON' ? 'Discount' : 'Increase' %>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
    
    <!-- How It Works -->
    <div class="mt-8 bg-blue-50 rounded-xl p-6 border border-blue-100">
      <h3 class="text-lg font-semibold text-blue-900 mb-4">How Dynamic Pricing Works</h3>
      <div class="grid md:grid-cols-2 gap-6 text-sm text-blue-800">
        <div class="flex gap-3">
          <div class="flex-shrink-0 w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center text-blue-600 font-bold">1</div>
          <div>
            <h4 class="font-medium mb-1">Automatic Activation</h4>
            <p>Rules activate automatically based on the booking date. No manual intervention needed.</p>
          </div>
        </div>
        <div class="flex gap-3">
          <div class="flex-shrink-0 w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center text-blue-600 font-bold">2</div>
          <div>
            <h4 class="font-medium mb-1">Multiplicative Stacking</h4>
            <p>When multiple rules apply (e.g., Weekend + Festive), adjustments compound for accurate pricing.</p>
          </div>
        </div>
        <div class="flex gap-3">
          <div class="flex-shrink-0 w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center text-blue-600 font-bold">3</div>
          <div>
            <h4 class="font-medium mb-1">Daily Calculation</h4>
            <p>Each night is priced independently. A 5-night stay might have different rates per night.</p>
          </div>
        </div>
        <div class="flex gap-3">
          <div class="flex-shrink-0 w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center text-blue-600 font-bold">4</div>
          <div>
            <h4 class="font-medium mb-1">Global Application</h4>
            <p>All pricing rules apply equally to all properties for consistent, fair pricing.</p>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Example Calculation -->
    <div class="mt-6 bg-white rounded-xl p-6 border border-gray-200">
      <h3 class="text-lg font-semibold text-gray-900 mb-4">Example Calculation</h3>
      <div class="bg-gray-50 rounded-lg p-4 font-mono text-sm">
        <div class="text-gray-600">Base Price: ₹5,000/night</div>
        <div class="text-gray-600 mt-1">Saturday Night + Diwali:</div>
        <div class="text-gray-900 mt-1">= ₹5,000 × 1.15 (Weekend) × 1.25 (Festive)</div>
        <div class="text-rose-600 font-bold mt-1">= ₹7,187/night</div>
      </div>
    </div>
  </main>
  
  <%- include('../partials/footer') %>
</body>
</html>
