<%- include('../partials/head') %>
  </head>
  <body class="min-h-screen bg-gradient-to-br from-rose-50 via-white to-orange-50">
    <%- include('../partials/nav') %>
    
    <main class="pt-20 pb-12 px-4 fade-in">
      <div class="max-w-2xl mx-auto">
        <!-- Profile Header -->
        <div class="bg-white rounded-2xl shadow-lg overflow-hidden mb-6">
          <div class="bg-rose-500 h-24"></div>
          <div class="px-6 pb-6">
            <div class="flex items-end -mt-12 mb-4">
              <div class="w-24 h-24 rounded-full bg-white p-1 shadow-lg">
                <div class="w-full h-full rounded-full bg-gray-700 flex items-center justify-center text-white text-3xl font-bold">
                  <%= user.firstName ? user.firstName.charAt(0).toUpperCase() : (user.email ? user.email.charAt(0).toUpperCase() : 'U') %>
                </div>
              </div>
              <div class="ml-4 mb-2">
                <h1 class="text-2xl font-bold text-gray-900"><%= user.firstName || user.email.split('@')[0] %> <%= user.lastName || '' %></h1>
                <p class="text-sm text-gray-500 capitalize flex items-center gap-1">
                  <% if (user.userType === 'host') { %>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-rose-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                    </svg>
                    Host
                  <% } else { %>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-rose-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                    </svg>
                    Guest
                  <% } %>
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Profile Information -->
        <div class="bg-white rounded-2xl shadow-lg p-6 mb-6">
          <div class="flex items-center justify-between mb-6">
            <h2 class="text-lg font-semibold text-gray-900">Personal Information</h2>
            <button onclick="toggleEditMode()" id="editBtn" class="text-sm text-rose-500 hover:text-rose-600 font-medium flex items-center gap-1">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
              </svg>
              Edit
            </button>
          </div>
          
          <%- include('../partials/errors') %>
          
          <!-- View Mode -->
          <div id="viewMode" class="space-y-4">
            <div class="flex items-center py-3 border-b border-gray-100">
              <div class="w-32 text-sm text-gray-500">First Name</div>
              <div class="flex-1 text-sm font-medium text-gray-900"><%= user.firstName || '-' %></div>
            </div>
            <div class="flex items-center py-3 border-b border-gray-100">
              <div class="w-32 text-sm text-gray-500">Last Name</div>
              <div class="flex-1 text-sm font-medium text-gray-900"><%= user.lastName || '-' %></div>
            </div>
            <div class="flex items-center py-3 border-b border-gray-100">
              <div class="w-32 text-sm text-gray-500">Email</div>
              <div class="flex-1 text-sm font-medium text-gray-900 flex items-center gap-2">
                <%= user.email %>
                <span class="text-xs bg-green-100 text-green-700 px-2 py-0.5 rounded-full">Verified</span>
              </div>
            </div>
            <div class="flex items-center py-3">
              <div class="w-32 text-sm text-gray-500">Account Type</div>
              <div class="flex-1 text-sm font-medium text-gray-900 capitalize"><%= user.userType || 'guest' %></div>
            </div>
          </div>
          
          <!-- Edit Mode (Hidden by default) -->
          <form action="/profile/update" method="POST" id="editMode" class="hidden space-y-4">
            <div>
              <label class="block text-xs font-medium text-gray-700 mb-1.5">First Name</label>
              <input type="text" name="firstName" value="<%= user.firstName || '' %>" 
                class="w-full px-4 py-2.5 text-sm rounded-lg border border-gray-300 focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition" required>
            </div>
            <div>
              <label class="block text-xs font-medium text-gray-700 mb-1.5">Last Name</label>
              <input type="text" name="lastName" value="<%= user.lastName || '' %>" 
                class="w-full px-4 py-2.5 text-sm rounded-lg border border-gray-300 focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition">
            </div>
            <div>
              <label class="block text-xs font-medium text-gray-700 mb-1.5">Email</label>
              <input type="email" name="email" value="<%= user.email %>" 
                class="w-full px-4 py-2.5 text-sm rounded-lg border border-gray-300 bg-gray-50 cursor-not-allowed" readonly>
              <p class="text-xs text-gray-400 mt-1">Email cannot be changed</p>
            </div>
            <div class="flex gap-3 pt-2">
              <button type="submit" class="bg-rose-500 hover:bg-rose-600 text-white px-5 py-2 rounded-lg text-sm font-medium transition-colors">
                Save Changes
              </button>
              <button type="button" onclick="toggleEditMode()" class="px-5 py-2 rounded-lg text-sm font-medium border border-gray-300 hover:bg-gray-50 transition">
                Cancel
              </button>
            </div>
          </form>
        </div>

        <!-- Account Stats -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
          <% if (user.userType === 'guest') { %>
            <div class="bg-white rounded-xl shadow p-4 text-center">
              <div class="text-2xl font-bold text-rose-500"><%= stats.totalBookings || 0 %></div>
              <div class="text-xs text-gray-500">Total Trips</div>
            </div>
            <div class="bg-white rounded-xl shadow p-4 text-center">
              <div class="text-2xl font-bold text-rose-500"><%= stats.totalFavourites || 0 %></div>
              <div class="text-xs text-gray-500">Saved</div>
            </div>
            <div class="bg-white rounded-xl shadow p-4 text-center">
              <div class="text-2xl font-bold text-rose-500"><%= stats.upcomingTrips || 0 %></div>
              <div class="text-xs text-gray-500">Upcoming</div>
            </div>
            <div class="bg-white rounded-xl shadow p-4 text-center">
              <div class="text-2xl font-bold text-rose-500"><%= stats.completedTrips || 0 %></div>
              <div class="text-xs text-gray-500">Completed</div>
            </div>
          <% } else { %>
            <div class="bg-white rounded-xl shadow p-4 text-center">
              <div class="text-2xl font-bold text-rose-500"><%= stats.totalListings || 0 %></div>
              <div class="text-xs text-gray-500">Listings</div>
            </div>
            <div class="bg-white rounded-xl shadow p-4 text-center">
              <div class="text-2xl font-bold text-rose-500"><%= stats.totalBookings || 0 %></div>
              <div class="text-xs text-gray-500">Bookings</div>
            </div>
            <div class="bg-white rounded-xl shadow p-4 text-center">
              <div class="text-2xl font-bold text-rose-500">₹<%= stats.totalEarnings || 0 %></div>
              <div class="text-xs text-gray-500">Earnings</div>
            </div>
            <div class="bg-white rounded-xl shadow p-4 text-center">
              <div class="text-2xl font-bold text-rose-500"><%= stats.avgRating || '0.0' %></div>
              <div class="text-xs text-gray-500">Avg Rating</div>
            </div>
          <% } %>
        </div>

        <!-- Quick Actions -->
        <div class="bg-white rounded-2xl shadow-lg p-6 mb-6">
          <h2 class="text-lg font-semibold text-gray-900 mb-4">Quick Actions</h2>
          <div class="grid grid-cols-2 gap-3">
            <% if (user.userType === 'guest') { %>
              <a href="/homes" class="flex items-center gap-3 p-4 rounded-xl border border-gray-200 hover:border-rose-300 hover:bg-rose-50 transition">
                <div class="w-10 h-10 rounded-lg bg-rose-100 flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-rose-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                  </svg>
                </div>
                <div>
                  <div class="text-sm font-medium text-gray-900">Explore Stays</div>
                  <div class="text-xs text-gray-500">Find your next trip</div>
                </div>
              </a>
              <a href="/favourites" class="flex items-center gap-3 p-4 rounded-xl border border-gray-200 hover:border-rose-300 hover:bg-rose-50 transition">
                <div class="w-10 h-10 rounded-lg bg-rose-100 flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-rose-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                  </svg>
                </div>
                <div>
                  <div class="text-sm font-medium text-gray-900">Wishlist</div>
                  <div class="text-xs text-gray-500">Your saved places</div>
                </div>
              </a>
              <a href="/bookings/my" class="flex items-center gap-3 p-4 rounded-xl border border-gray-200 hover:border-rose-300 hover:bg-rose-50 transition">
                <div class="w-10 h-10 rounded-lg bg-rose-100 flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-rose-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                  </svg>
                </div>
                <div>
                  <div class="text-sm font-medium text-gray-900">My Trips</div>
                  <div class="text-xs text-gray-500">View bookings</div>
                </div>
              </a>
            <% } else { %>
              <a href="/host/add-home" class="flex items-center gap-3 p-4 rounded-xl border border-gray-200 hover:border-rose-300 hover:bg-rose-50 transition">
                <div class="w-10 h-10 rounded-lg bg-rose-100 flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-rose-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                  </svg>
                </div>
                <div>
                  <div class="text-sm font-medium text-gray-900">Add Listing</div>
                  <div class="text-xs text-gray-500">List a new property</div>
                </div>
              </a>
              <a href="/host/host-home-list" class="flex items-center gap-3 p-4 rounded-xl border border-gray-200 hover:border-rose-300 hover:bg-rose-50 transition">
                <div class="w-10 h-10 rounded-lg bg-rose-100 flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-rose-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                  </svg>
                </div>
                <div>
                  <div class="text-sm font-medium text-gray-900">My Listings</div>
                  <div class="text-xs text-gray-500">Manage properties</div>
                </div>
              </a>
              <a href="/pricing/rules" class="flex items-center gap-3 p-4 rounded-xl border border-gray-200 hover:border-rose-300 hover:bg-rose-50 transition">
                <div class="w-10 h-10 rounded-lg bg-rose-100 flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-rose-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                </div>
                <div>
                  <div class="text-sm font-medium text-gray-900">Pricing</div>
                  <div class="text-xs text-gray-500">Set dynamic pricing</div>
                </div>
              </a>
            <% } %>
            <button onclick="openLogoutModal()" class="flex items-center gap-3 p-4 rounded-xl border border-gray-200 hover:border-red-300 hover:bg-red-50 transition">
              <div class="w-10 h-10 rounded-lg bg-red-100 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                </svg>
              </div>
              <div>
                <div class="text-sm font-medium text-red-600">Logout</div>
                <div class="text-xs text-gray-500">Sign out safely</div>
              </div>
            </button>
          </div>
        </div>

        <!-- Account Security -->
        <div class="bg-white rounded-2xl shadow-lg p-6">
          <h2 class="text-lg font-semibold text-gray-900 mb-4">Security</h2>
          <div class="space-y-3">
            <a href="/profile/change-password" class="flex items-center justify-between p-4 rounded-xl border border-gray-200 hover:border-rose-300 hover:bg-rose-50 transition">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-lg bg-gray-100 flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                  </svg>
                </div>
                <div>
                  <div class="text-sm font-medium text-gray-900">Change Password</div>
                  <div class="text-xs text-gray-500">Update your password</div>
                </div>
              </div>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </main>

    <!-- Logout Confirmation Modal -->
    <div id="logoutModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 backdrop-blur-sm">
      <div class="bg-white rounded-2xl shadow-2xl p-6 max-w-sm w-full mx-4 transform scale-95 opacity-0 transition-all duration-200" id="logoutModalContent">
        <div class="text-center">
          <div class="w-16 h-16 rounded-full bg-red-100 flex items-center justify-center mx-auto mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">Log out?</h3>
          <p class="text-sm text-gray-500 mb-6">Are you sure you want to log out of your account?</p>
          <div class="flex gap-3">
            <button onclick="closeLogoutModal()" class="flex-1 px-4 py-2.5 rounded-lg border border-gray-300 text-sm font-medium hover:bg-gray-50 transition">
              Cancel
            </button>
            <form action="/logout" method="POST" class="flex-1">
              <button type="submit" class="w-full px-4 py-2.5 rounded-lg bg-red-500 text-white text-sm font-medium hover:bg-red-600 transition">
                Log out
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>

    <script>
      // Edit mode toggle
      function toggleEditMode() {
        const viewMode = document.getElementById('viewMode');
        const editMode = document.getElementById('editMode');
        const editBtn = document.getElementById('editBtn');
        
        if (viewMode.classList.contains('hidden')) {
          viewMode.classList.remove('hidden');
          editMode.classList.add('hidden');
          editBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg> Edit';
        } else {
          viewMode.classList.add('hidden');
          editMode.classList.remove('hidden');
          editBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg> Cancel';
        }
      }
      
      // Logout modal
      function openLogoutModal() {
        const modal = document.getElementById('logoutModal');
        const content = document.getElementById('logoutModalContent');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        setTimeout(() => {
          content.classList.remove('scale-95', 'opacity-0');
          content.classList.add('scale-100', 'opacity-100');
        }, 10);
      }
      
      function closeLogoutModal() {
        const modal = document.getElementById('logoutModal');
        const content = document.getElementById('logoutModalContent');
        content.classList.remove('scale-100', 'opacity-100');
        content.classList.add('scale-95', 'opacity-0');
        setTimeout(() => {
          modal.classList.add('hidden');
          modal.classList.remove('flex');
        }, 200);
      }
      
      // Close modal on backdrop click
      document.getElementById('logoutModal').addEventListener('click', (e) => {
        if (e.target === document.getElementById('logoutModal')) {
          closeLogoutModal();
        }
      });
      
      // User dropdown toggle
      const userMenuBtn = document.getElementById('userMenuBtn');
      const userMenu = document.getElementById('userMenu');
      
      if (userMenuBtn && userMenu) {
        userMenuBtn.addEventListener('click', () => {
          userMenu.classList.toggle('hidden');
        });
        
        document.addEventListener('click', (e) => {
          if (!userMenuBtn.contains(e.target) && !userMenu.contains(e.target)) {
            userMenu.classList.add('hidden');
          }
        });
      }
    </script>
    
    <%- include('../partials/footer') %>
  </body>
</html>
