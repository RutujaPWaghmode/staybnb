<%- include('../partials/head') %>
  </head>
  <body class="min-h-screen bg-gradient-to-br from-rose-50 via-white to-orange-50">
    <%- include('../partials/nav') %>
    
    <main class="flex items-center justify-center px-4 py-8 fade-in">
      <div class="w-full max-w-md">
        <!-- Signup Card -->
        <div class="bg-white rounded-2xl shadow-xl overflow-hidden">
          <!-- Header -->
          <div class="gradient-animated px-6 py-6 text-white text-center">
            <div class="w-14 h-14 bg-white/20 rounded-xl mx-auto mb-3 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-7 h-7">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 7.5v3m0 0v3m0-3h3m-3 0h-3m-2.25-4.125a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zM4 19.235v-.11a6.375 6.375 0 0112.75 0v.109A12.318 12.318 0 0110.374 21c-2.331 0-4.512-.645-6.374-1.766z"/>
              </svg>
            </div>
            <h1 class="text-xl font-bold">Join StayBnB</h1>
            <p class="text-white/80 text-xs mt-1">Create your account and start exploring</p>
          </div>
          
          <!-- Form Section -->
          <div class="p-6">
            <%- include('../partials/errors') %>
            
            <form action="/signup" method="POST" class="space-y-4">
              <!-- Name Field -->
              <div>
                <label for="firstName" class="block text-xs font-medium text-gray-700 mb-1.5">Full Name</label>
                <div class="relative">
                  <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                    </svg>
                  </span>
                  <input
                    type="text"
                    id="firstName"
                    name="firstName"
                    placeholder="John Doe"
                    value="<%= oldInput.firstName ? oldInput.firstName : '' %>"
                    class="w-full pl-10 pr-3 py-2.5 text-sm rounded-lg border border-gray-300 focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition text-gray-800 placeholder-gray-400"
                    required />
                </div>
              </div>
              
              <!-- Email Field -->
              <div>
                <label for="email" class="block text-xs font-medium text-gray-700 mb-1.5">Email Address</label>
                <div class="relative">
                  <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                    </svg>
                  </span>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    placeholder="your@email.com"
                    value="<%= oldInput.email ? oldInput.email : '' %>"
                    class="w-full pl-10 pr-3 py-2.5 text-sm rounded-lg border border-gray-300 focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition text-gray-800 placeholder-gray-400"
                    required />
                </div>
              </div>
              
              <!-- Password Field -->
              <div>
                <label for="password" class="block text-xs font-medium text-gray-700 mb-1.5">Password</label>
                <div class="relative">
                  <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                    </svg>
                  </span>
                  <input
                    type="password"
                    id="password"
                    name="password"
                    placeholder="Minimum 6 characters"
                    class="w-full pl-10 pr-3 py-2.5 text-sm rounded-lg border border-gray-300 focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition text-gray-800 placeholder-gray-400"
                    required />
                </div>
              </div>
              
              <!-- Confirm Password Field -->
              <div>
                <label for="confirmPassword" class="block text-xs font-medium text-gray-700 mb-1.5">Confirm Password</label>
                <div class="relative">
                  <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                    </svg>
                  </span>
                  <input
                    type="password"
                    id="confirmPassword"
                    name="confirmPassword"
                    placeholder="Repeat your password"
                    class="w-full pl-10 pr-3 py-2.5 text-sm rounded-lg border border-gray-300 focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition text-gray-800 placeholder-gray-400"
                    required />
                </div>
              </div>
              
              <!-- User Type Selection -->
              <div>
                <label class="block text-xs font-medium text-gray-700 mb-2">I want to</label>
                <div class="flex gap-3">
                  <label class="flex-1 cursor-pointer group">
                    <input type="radio" name="userType" value="guest" class="sr-only peer" <%= oldInput.userType === 'host' ? '' : 'checked' %>>
                    <div class="p-3 rounded-lg border-2 border-gray-200 peer-checked:border-rose-500 peer-checked:bg-rose-50 transition-all text-center hover:border-gray-300">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mx-auto text-gray-400 group-has-[:checked]:text-rose-500 mb-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                      </svg>
                      <p class="text-xs font-medium text-gray-900 group-has-[:checked]:text-rose-600">Find stays</p>
                      <p class="text-[10px] text-gray-400 mt-0.5">Book places</p>
                    </div>
                  </label>
                  <label class="flex-1 cursor-pointer group">
                    <input type="radio" name="userType" value="host" class="sr-only peer" <%= oldInput.userType === 'host' ? 'checked' : '' %>>
                    <div class="p-3 rounded-lg border-2 border-gray-200 peer-checked:border-rose-500 peer-checked:bg-rose-50 transition-all text-center hover:border-gray-300">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mx-auto text-gray-400 group-has-[:checked]:text-rose-500 mb-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                      </svg>
                      <p class="text-xs font-medium text-gray-900 group-has-[:checked]:text-rose-600">Host places</p>
                      <p class="text-[10px] text-gray-400 mt-0.5">List property</p>
                    </div>
                  </label>
                </div>
              </div>
              
              <!-- Terms -->
              <div class="flex items-start gap-2">
                <input type="checkbox" id="terms" name="terms" required class="w-4 h-4 mt-0.5 text-rose-500 border-gray-300 rounded focus:ring-rose-500">
                <label for="terms" class="text-xs text-gray-600 leading-tight">
                  I agree to the <a href="#" class="text-rose-500 hover:underline">Terms</a> and <a href="#" class="text-rose-500 hover:underline">Privacy Policy</a>
                </label>
              </div>
              
              <!-- Submit Button -->
              <button type="submit" class="w-full gradient-animated text-white py-2.5 rounded-lg font-medium text-sm hover:shadow-md transition-all flex items-center justify-center gap-2">
                <span>Create Account</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                </svg>
              </button>
            </form>
            
            <!-- Login Link -->
            <p class="text-center mt-5 text-sm text-gray-600">
              Already have an account? 
              <a href="/login" class="text-rose-500 hover:text-rose-600 font-medium">Sign in</a>
            </p>
          </div>
        </div>
      </div>
    </main>
    
    <script>
      // User type selection - ensure visual feedback works
      document.querySelectorAll('input[name="userType"]').forEach(radio => {
        radio.addEventListener('change', function() {
          // Reset all cards
          document.querySelectorAll('input[name="userType"]').forEach(r => {
            const card = r.closest('label').querySelector('div');
            const icon = card.querySelector('svg');
            const text = card.querySelector('p');
            card.classList.remove('border-rose-500', 'bg-rose-50');
            card.classList.add('border-gray-200');
            icon.classList.remove('text-rose-500');
            icon.classList.add('text-gray-400');
            text.classList.remove('text-rose-600');
            text.classList.add('text-gray-900');
          });
          // Highlight selected
          const card = this.closest('label').querySelector('div');
          const icon = card.querySelector('svg');
          const text = card.querySelector('p');
          card.classList.add('border-rose-500', 'bg-rose-50');
          card.classList.remove('border-gray-200');
          icon.classList.add('text-rose-500');
          icon.classList.remove('text-gray-400');
          text.classList.add('text-rose-600');
          text.classList.remove('text-gray-900');
        });
        
        // Trigger change on page load for checked radio
        if (radio.checked) {
          radio.dispatchEvent(new Event('change'));
        }
      });
    </script>
  </body>
</html>
