<%- include('../partials/head') %>
  </head>
  <body class="min-h-screen">
    <!-- Colorful Background Pattern -->
    <div class="fixed inset-0 z-0">
      <div class="absolute inset-0 bg-gradient-to-br from-amber-100 via-rose-100 to-cyan-100"></div>
      <div class="absolute inset-0 opacity-40" style="background-image: url('https://images.unsplash.com/photo-1501785888041-af3ef285b470?auto=format&fit=crop&w=1920&q=80'); background-size: cover; background-position: center; filter: blur(8px);"></div>
      <div class="absolute inset-0 bg-black/30 backdrop-blur-sm"></div>
    </div>
    
    <!-- Login Modal -->
    <main class="relative z-10 min-h-screen flex items-center justify-center px-4 py-8">
      <div class="w-full max-w-md">
        <!-- Modal Card -->
        <div class="bg-white rounded-3xl shadow-2xl overflow-hidden animate-in" style="animation: modalSlideIn 0.4s ease-out;">
          <!-- Header with Close Button -->
          <div class="relative px-6 py-4 border-b border-gray-100">
            <a href="/" class="absolute left-4 top-1/2 -translate-y-1/2 w-8 h-8 flex items-center justify-center rounded-full hover:bg-gray-100 transition">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gray-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
              </svg>
            </a>
            <h2 class="text-center text-base font-semibold text-gray-900">Log in or sign up</h2>
          </div>
          
          <!-- Form Content -->
          <div class="p-6">
            <!-- Logo -->
            <div class="flex justify-center mb-6">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 36 40" class="w-12 h-14" fill="none">
                <path d="M18 0C8.06 0 0 8.06 0 18c0 9.94 18 22 18 22s18-12.06 18-22C36 8.06 27.94 0 18 0z" fill="#FF385C"/>
                <path d="M18 8l-9 7v10h6v-6h6v6h6V15l-9-7z" fill="white"/>
                <rect x="16" y="19" width="4" height="6" rx="0.5" fill="#FF385C"/>
              </svg>
            </div>
            
            <h1 class="text-2xl font-semibold text-gray-900 text-center mb-6">Welcome to StayBnB</h1>
            
            <%- include('../partials/errors') %>
            
            <form action="/login" method="POST" class="space-y-4" data-loading>
              <!-- Email/Phone Field -->
              <div>
                <div class="relative">
                  <input
                    type="email"
                    id="email"
                    name="email"
                    placeholder=" "
                    value="<%= oldInput.email ? oldInput.email : '' %>"
                    class="peer w-full px-4 pt-6 pb-2 text-base rounded-xl border border-gray-300 focus:border-gray-900 focus:ring-0 focus:outline-none transition text-gray-900"
                    required />
                  <label for="email" class="absolute left-4 top-4 text-gray-500 text-base transition-all duration-200 peer-placeholder-shown:top-4 peer-placeholder-shown:text-base peer-focus:top-2 peer-focus:text-xs peer-[:not(:placeholder-shown)]:top-2 peer-[:not(:placeholder-shown)]:text-xs">
                    Phone number or email
                  </label>
                </div>
              </div>
              
              <!-- Password Field -->
              <div>
                <div class="relative">
                  <input
                    type="password"
                    id="password"
                    name="password"
                    placeholder=" "
                    class="peer w-full px-4 pt-6 pb-2 pr-12 text-base rounded-xl border border-gray-300 focus:border-gray-900 focus:ring-0 focus:outline-none transition text-gray-900"
                    required />
                  <label for="password" class="absolute left-4 top-4 text-gray-500 text-base transition-all duration-200 peer-placeholder-shown:top-4 peer-placeholder-shown:text-base peer-focus:top-2 peer-focus:text-xs peer-[:not(:placeholder-shown)]:top-2 peer-[:not(:placeholder-shown)]:text-xs">
                    Password
                  </label>
                  <button type="button" id="togglePassword" class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-500 hover:text-gray-700 transition">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" id="eyeIcon">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                    </svg>
                  </button>
                </div>
              </div>
              
              <!-- Login As Selection -->
              <div class="mt-4">
                <p class="text-sm font-medium text-gray-700 mb-3">Login as:</p>
                <div class="flex gap-4">
                  <label class="flex-1 relative cursor-pointer">
                    <input type="radio" name="loginType" value="guest" class="peer sr-only" <%= oldInput.loginType === 'host' ? '' : 'checked' %> />
                    <div class="flex items-center justify-center gap-2 px-4 py-3 rounded-xl border-2 border-gray-200 peer-checked:border-rose-500 peer-checked:bg-rose-50 transition-all duration-200">
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-gray-600 peer-checked:text-rose-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                      </svg>
                      <span class="font-medium text-gray-700">Guest</span>
                    </div>
                  </label>
                  <label class="flex-1 relative cursor-pointer">
                    <input type="radio" name="loginType" value="host" class="peer sr-only" <%= oldInput.loginType === 'host' ? 'checked' : '' %> />
                    <div class="flex items-center justify-center gap-2 px-4 py-3 rounded-xl border-2 border-gray-200 peer-checked:border-rose-500 peer-checked:bg-rose-50 transition-all duration-200">
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-gray-600 peer-checked:text-rose-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                      </svg>
                      <span class="font-medium text-gray-700">Host</span>
                    </div>
                  </label>
                </div>
              </div>
              
              <!-- Privacy Text -->
              <p class="text-xs text-gray-500 leading-relaxed">
                We'll send a confirmation code by text or email. Message and data rates apply.
                <a href="/privacy" class="underline font-medium">Privacy Policy</a>
              </p>
              
              <!-- Continue Button -->
              <button type="submit" class="w-full py-3.5 rounded-xl font-semibold text-white text-base transition-all duration-200 hover:scale-[1.02] active:scale-[0.98]" style="background: linear-gradient(to right, #E61E4D, #E31C5F, #D70466);">
                Continue
              </button>
            </form>
            
            <!-- Divider -->
            <div class="relative my-6">
              <div class="absolute inset-0 flex items-center">
                <div class="w-full border-t border-gray-200"></div>
              </div>
              <div class="relative flex justify-center text-sm">
                <span class="px-4 bg-white text-gray-500">or</span>
              </div>
            </div>
            
            <!-- Social Login Buttons -->
            <div class="flex justify-center gap-4">
              <!-- Google Button -->
              <button type="button" class="w-12 h-12 flex items-center justify-center rounded-full border border-gray-300 hover:bg-gray-50 hover:border-gray-400 transition-all duration-200">
                <svg class="w-5 h-5" viewBox="0 0 24 24">
                  <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                  <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                  <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                  <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                </svg>
              </button>
              
              <!-- Apple Button -->
              <button type="button" class="w-12 h-12 flex items-center justify-center rounded-full border border-gray-300 hover:bg-gray-50 hover:border-gray-400 transition-all duration-200">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
                </svg>
              </button>
              
              <!-- Facebook Button -->
              <button type="button" class="w-12 h-12 flex items-center justify-center rounded-full border border-gray-300 hover:bg-gray-50 hover:border-gray-400 transition-all duration-200">
                <svg class="w-5 h-5 text-[#1877F2]" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/>
                </svg>
              </button>
              
              <!-- Email Button (for those who prefer email only) -->
              <button type="button" class="w-12 h-12 flex items-center justify-center rounded-full border border-gray-300 hover:bg-gray-50 hover:border-gray-400 transition-all duration-200" onclick="document.getElementById('email').focus()">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-gray-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </button>
            </div>
            
            <!-- Sign Up Link -->
            <p class="text-center mt-6 text-sm text-gray-600">
              Don't have an account? 
              <a href="/signup" class="text-rose-500 hover:text-rose-600 font-semibold underline underline-offset-2">Sign up</a>
            </p>
          </div>
        </div>
      </div>
    </main>
    
    <style>
      @keyframes modalSlideIn {
        from {
          opacity: 0;
          transform: translateY(20px) scale(0.98);
        }
        to {
          opacity: 1;
          transform: translateY(0) scale(1);
        }
      }
      
      /* Floating label animation */
      input:focus ~ label,
      input:not(:placeholder-shown) ~ label {
        top: 0.5rem;
        font-size: 0.75rem;
      }
    </style>
    
    <script>
      const togglePassword = document.getElementById('togglePassword');
      const passwordInput = document.getElementById('password');
      const eyeIcon = document.getElementById('eyeIcon');
      
      togglePassword.addEventListener('click', () => {
        const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
        passwordInput.setAttribute('type', type);
        
        if (type === 'text') {
          eyeIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/>';
        } else {
          eyeIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>';
        }
      });
    </script>
  </body>
</html>
