<%- include('../partials/head') %>
  </head>
  <body class="bg-gray-50">
    <%- include('../partials/nav') %>
    <main class="container mx-auto p-6 mt-10 max-w-2xl">
      <div class="bg-white rounded-xl shadow-lg overflow-hidden">
        <!-- Header -->
        <div class="bg-red-500 p-6 text-white">
          <h2 class="text-2xl font-bold flex items-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 mr-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            Cancel Booking
          </h2>
          <p class="text-red-100 mt-1">Please review the cancellation details before proceeding</p>
        </div>

        <!-- Booking Details -->
        <div class="p-6 border-b">
          <div class="flex gap-4">
            <% if (home && home.photo) { %>
              <img src="/<%= home.photo %>" alt="<%= home.houseName %>" class="w-24 h-24 object-cover rounded-lg">
            <% } %>
            <div class="flex-1">
              <h3 class="text-xl font-semibold text-gray-800"><%= home ? home.houseName : 'Property' %></h3>
              <% if (home && home.location) { %>
                <p class="text-gray-500 text-sm flex items-center mt-1">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  </svg>
                  <%= home.location %>
                </p>
              <% } %>
              <div class="flex gap-6 mt-3 text-sm">
                <div>
                  <span class="text-gray-500">Check-in:</span>
                  <span class="font-medium ml-1"><%= booking.checkInDate.toDateString() %></span>
                </div>
                <div>
                  <span class="text-gray-500">Check-out:</span>
                  <span class="font-medium ml-1"><%= booking.checkOutDate.toDateString() %></span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Cancellation Policy Info -->
        <div class="p-6 bg-gray-50 border-b">
          <h4 class="font-semibold text-gray-700 mb-3 flex items-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Cancellation Policy: <%= policy.name %>
          </h4>
          <p class="text-sm text-gray-600"><%= policy.description %></p>
        </div>

        <!-- Refund Calculation -->
        <div class="p-6 border-b">
          <h4 class="font-semibold text-gray-700 mb-4">Refund Details</h4>
          <div class="space-y-3">
            <div class="flex justify-between">
              <span class="text-gray-600">Original Amount:</span>
              <span class="font-medium">₹<%= booking.totalPrice.toLocaleString('en-IN') %></span>
            </div>
            <div class="flex justify-between">
              <span class="text-gray-600">Refund Percentage:</span>
              <span class="font-medium <%= refundInfo.refundPercent === 100 ? 'text-green-600' : refundInfo.refundPercent > 0 ? 'text-yellow-600' : 'text-red-600' %>">
                <%= refundInfo.refundPercent %>%
              </span>
            </div>
            <div class="flex justify-between pt-3 border-t border-dashed">
              <span class="text-lg font-semibold text-gray-800">Refund Amount:</span>
              <span class="text-lg font-bold <%= refundInfo.refundAmount > 0 ? 'text-green-600' : 'text-red-600' %>">
                ₹<%= refundInfo.refundAmount.toLocaleString('en-IN') %>
              </span>
            </div>
          </div>
          
          <div class="mt-4 p-3 rounded-lg <%= refundInfo.refundPercent === 100 ? 'bg-green-50 text-green-700' : refundInfo.refundPercent > 0 ? 'bg-yellow-50 text-yellow-700' : 'bg-red-50 text-red-700' %>">
            <p class="text-sm flex items-start">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <%= refundInfo.message %>
            </p>
          </div>
        </div>

        <!-- Cancellation Form -->
        <form action="/bookings/<%= booking._id %>/cancel" method="POST" class="p-6">
          <div class="mb-6">
            <label for="reason" class="block text-sm font-medium text-gray-700 mb-2">
              Reason for cancellation (optional)
            </label>
            <textarea 
              name="reason" 
              id="reason" 
              rows="3" 
              placeholder="Please let us know why you're cancelling..."
              class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-red-500 focus:border-transparent"
            ></textarea>
          </div>

          <div class="flex gap-4">
            <a href="/bookings/my" class="flex-1 text-center py-3 px-4 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition font-medium">
              Keep Booking
            </a>
            <button type="submit" class="flex-1 py-3 px-4 bg-red-500 hover:bg-red-600 text-white rounded-lg transition font-medium flex items-center justify-center" 
              onclick="return confirm('Are you sure you want to cancel this booking? This action cannot be undone.')">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
              Confirm Cancellation
            </button>
          </div>

          <p class="text-xs text-gray-500 text-center mt-4">
            By cancelling, you agree to our <a href="/bookings/policy" class="text-red-500 hover:underline">cancellation policy</a>.
            <% if (refundInfo.refundAmount > 0) { %>
              Refunds are typically processed within 5-7 business days.
            <% } %>
          </p>
        </form>
      </div>
    </main>
  </body>
</html>