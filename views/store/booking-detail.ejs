<%- include('../partials/head') %>
  </head>
  <body class="bg-gray-50">
    <%- include('../partials/nav') %>
    <main class="container mx-auto bg-white shadow-lg rounded-lg p-8 mt-10 max-w-3xl">
      <h2 class="text-3xl text-red-500 font-bold text-center mb-6">Booking Details</h2>

      <% var listing = booking.listingId; %>
      <% if (listing) { %>
        <% if (listing.photo) { %>
          <img src="/<%= listing.photo %>" alt="<%= listing.houseName %>" class="w-full h-64 object-cover rounded-lg mb-6"
               onerror="this.onerror=null; this.src='/images/house1.png';">
        <% } else { %>
          <img src="/images/house1.png" alt="<%= listing.houseName %>" class="w-full h-64 object-cover rounded-lg mb-6">
        <% } %>
        <h3 class="text-2xl font-semibold mb-2"><%= listing.houseName %></h3>
        <p class="text-gray-600 mb-4"><%= listing.location %></p>
      <% } else { %>
        <p class="text-gray-500 italic mb-4">Listing has been removed.</p>
      <% } %>

      <!-- Dynamic Pricing Alert -->
      <% 
        const originalPrice = booking.originalPrice || booking.totalPrice;
        const priceDifference = booking.totalPrice - originalPrice;
        const percentChange = originalPrice > 0 ? Math.round((priceDifference / originalPrice) * 100) : 0;
        const hasRules = booking.appliedPricingRules && booking.appliedPricingRules.length > 0;
      %>
      
      <% if (hasRules && priceDifference > 0) { %>
        <!-- Higher Price Alert -->
        <div class="mb-6 p-4 bg-amber-50 rounded-xl border border-amber-200">
          <div class="flex items-start gap-3">
            <div class="flex-shrink-0 w-10 h-10 bg-amber-100 rounded-full flex items-center justify-center">
              <svg class="w-6 h-6 text-amber-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M12.395 2.553a1 1 0 00-1.45-.385c-.345.23-.614.558-.822.88-.214.33-.403.713-.57 1.116-.334.804-.614 1.768-.84 2.734a31.365 31.365 0 00-.613 3.58 2.64 2.64 0 01-.945-1.067c-.328-.68-.398-1.534-.398-2.654A1 1 0 005.05 6.05 6.981 6.981 0 003 11a7 7 0 1011.95-4.95c-.592-.591-.98-.985-1.348-1.467-.363-.476-.724-1.063-1.207-2.03zM12.12 15.12A3 3 0 017 13s.879.5 2.5.5c0-1 .5-4 1.25-4.5.5 1 .786 1.293 1.371 1.879A2.99 2.99 0 0113 13a2.99 2.99 0 01-.879 2.121z" clip-rule="evenodd"/>
              </svg>
            </div>
            <div class="flex-1">
              <p class="font-semibold text-amber-800">Peak Season Pricing Applied</p>
              <p class="text-sm text-amber-700 mt-1">
                <strong><%= booking.appliedPricingRules.join(', ') %></strong> was active during your booking dates.
              </p>
              <div class="mt-2 flex items-center gap-3 text-sm">
                <span class="text-amber-600 line-through">₹<%= originalPrice.toLocaleString('en-IN') %></span>
                <span class="text-lg font-bold text-amber-800">→ ₹<%= booking.totalPrice.toLocaleString('en-IN') %></span>
                <span class="bg-amber-200 text-amber-800 px-2 py-0.5 rounded-full text-xs font-medium">+<%= percentChange %>%</span>
              </div>
            </div>
          </div>
        </div>
      <% } else if (hasRules && priceDifference < 0) { %>
        <!-- Lower Price Alert (Discount) -->
        <div class="mb-6 p-4 bg-green-50 rounded-xl border border-green-200">
          <div class="flex items-start gap-3">
            <div class="flex-shrink-0 w-10 h-10 bg-green-100 rounded-full flex items-center justify-center">
              <svg class="w-6 h-6 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
            </div>
            <div class="flex-1">
              <p class="font-semibold text-green-800">🎉 You Saved Money!</p>
              <p class="text-sm text-green-700 mt-1">
                <strong><%= booking.appliedPricingRules.join(', ') %></strong> discount was applied to your booking.
              </p>
              <div class="mt-2 flex items-center gap-3 text-sm">
                <span class="text-green-600 line-through">₹<%= originalPrice.toLocaleString('en-IN') %></span>
                <span class="text-lg font-bold text-green-700">→ ₹<%= booking.totalPrice.toLocaleString('en-IN') %></span>
                <span class="bg-green-200 text-green-800 px-2 py-0.5 rounded-full text-xs font-medium">-<%= Math.abs(percentChange) %>% OFF</span>
              </div>
              <p class="text-xs text-green-600 mt-1">You saved ₹<%= Math.abs(priceDifference).toLocaleString('en-IN') %>!</p>
            </div>
          </div>
        </div>
      <% } %>

      <div class="grid grid-cols-2 gap-4 border-t pt-4">
        <div>
          <p class="text-sm text-gray-500">Check-in</p>
          <p class="font-semibold"><%= booking.checkInDate.toDateString() %></p>
        </div>
        <div>
          <p class="text-sm text-gray-500">Check-out</p>
          <p class="font-semibold"><%= booking.checkOutDate.toDateString() %></p>
        </div>
        <div>
          <p class="text-sm text-gray-500">Booking Status</p>
          <p class="font-semibold capitalize <%= booking.bookingStatus === 'confirmed' ? 'text-green-600' : booking.bookingStatus === 'pending' ? 'text-yellow-600' : 'text-red-600' %>">
            <%= booking.bookingStatus %>
          </p>
        </div>
        <div>
          <p class="text-sm text-gray-500">Payment Status</p>
          <p class="font-semibold capitalize <%= booking.paymentStatus === 'completed' ? 'text-green-600' : booking.paymentStatus === 'pending' ? 'text-orange-600' : 'text-red-600' %>">
            <%= booking.paymentStatus || 'N/A' %>
          </p>
        </div>
        <div>
          <p class="text-sm text-gray-500">Total Price</p>
          <p class="font-semibold text-green-600">₹<%= booking.totalPrice %></p>
        </div>
        <div>
          <p class="text-sm text-gray-500">Booked On</p>
          <p class="font-semibold"><%= booking.createdAt.toDateString() %></p>
        </div>
        <% if (booking.razorpayPaymentId) { %>
        <div class="col-span-2">
          <p class="text-sm text-gray-500">Payment ID</p>
          <p class="font-semibold text-xs text-gray-600"><%= booking.razorpayPaymentId %></p>
        </div>
        <% } %>
      </div>

      <div class="mt-6 flex flex-wrap gap-4 justify-center">
        <% if (booking.paymentStatus === 'completed') { %>
          <a href="/invoice/<%= booking._id %>" class="inline-flex items-center bg-blue-500 text-white px-5 py-2 rounded-lg hover:bg-blue-600 transition">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
            Download Invoice
          </a>
        <% } else if (booking.paymentStatus === 'pending' && booking.bookingStatus !== 'cancelled') { %>
          <a href="/payment/<%= booking._id %>" class="inline-block bg-green-500 text-white px-5 py-2 rounded-lg hover:bg-green-600 transition">Complete Payment</a>
        <% } %>
        <a href="/bookings/my" class="inline-block bg-red-500 text-white px-5 py-2 rounded-lg hover:bg-red-600 transition">Back to My Bookings</a>
      </div>
    </main>
  </body>
</html>
