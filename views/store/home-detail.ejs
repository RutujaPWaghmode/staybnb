<%- include('../partials/head') %>
  </head>
  <body class="bg-gray-50 antialiased">
    <%- include('../partials/nav') %>
    
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 fade-in">
      <!-- Breadcrumb -->
      <nav class="mb-6">
        <ol class="flex items-center space-x-2 text-sm text-gray-500">
          <li><a href="/" class="hover:text-rose-500 transition">Home</a></li>
          <li><span>/</span></li>
          <li><a href="/homes" class="hover:text-rose-500 transition">Explore</a></li>
          <li><span>/</span></li>
          <li class="text-gray-900 font-medium truncate max-w-[200px]"><%= home.houseName %></li>
        </ol>
      </nav>

      <div class="grid lg:grid-cols-3 gap-8">
        <!-- Main Content -->
        <div class="lg:col-span-2">
          <!-- Property Header -->
          <div class="mb-6">
            <div class="flex items-start justify-between mb-4">
              <div>
                <% if (home.propertyType) { %>
                  <span class="inline-block px-3 py-1 bg-rose-100 text-rose-700 text-xs font-semibold rounded-full mb-3 capitalize">
                    <%= home.propertyType %>
                  </span>
                <% } %>
                <h1 class="text-3xl md:text-4xl font-bold text-gray-900 font-display"><%= home.houseName %></h1>
              </div>
              <div class="text-right">
                <%- include('../partials/favourite') %>
              </div>
            </div>
            
            <div class="flex flex-wrap items-center gap-4 text-gray-600">
              <div class="flex items-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-1.5 text-amber-400" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
                <span class="font-semibold text-gray-900"><%= home.rating %></span>
              </div>
              <span class="text-gray-300">•</span>
              <div class="flex items-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-1.5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                </svg>
                <span><%= home.location %></span>
              </div>
            </div>
          </div>

          <!-- Property Image -->
          <div class="rounded-3xl overflow-hidden mb-8 shadow-lg">
            <img src="<%= home.photo %>" alt="<%= home.houseName %>" class="w-full h-[400px] md:h-[500px] object-cover">
          </div>

          <!-- Quick Stats -->
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
            <div class="bg-white rounded-2xl p-5 text-center shadow-sm border border-gray-100">
              <div class="w-12 h-12 bg-rose-100 rounded-xl flex items-center justify-center mx-auto mb-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-rose-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                </svg>
              </div>
              <p class="text-2xl font-bold text-gray-900"><%= home.maxGuests || 2 %></p>
              <p class="text-sm text-gray-500">Guests</p>
            </div>
            <div class="bg-white rounded-2xl p-5 text-center shadow-sm border border-gray-100">
              <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center mx-auto mb-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                </svg>
              </div>
              <p class="text-2xl font-bold text-gray-900"><%= home.bedrooms || 1 %></p>
              <p class="text-sm text-gray-500">Bedrooms</p>
            </div>
            <div class="bg-white rounded-2xl p-5 text-center shadow-sm border border-gray-100">
              <div class="w-12 h-12 bg-emerald-100 rounded-xl flex items-center justify-center mx-auto mb-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 14v6m-3-3h6M6 10h2a4 4 0 014 4v1a3 3 0 01-3 3H5a3 3 0 01-3-3v-1a4 4 0 014-4zm0 0V6a4 4 0 014-4h1a2 2 0 012 2v2"/>
                </svg>
              </div>
              <p class="text-2xl font-bold text-gray-900"><%= home.bathrooms || 1 %></p>
              <p class="text-sm text-gray-500">Bathrooms</p>
            </div>
            <div class="bg-white rounded-2xl p-5 text-center shadow-sm border border-gray-100">
              <div class="w-12 h-12 bg-amber-100 rounded-xl flex items-center justify-center mx-auto mb-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-amber-600" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              </div>
              <p class="text-2xl font-bold text-gray-900"><%= home.rating %></p>
              <p class="text-sm text-gray-500">Rating</p>
            </div>
          </div>

          <!-- Description -->
          <div class="bg-white rounded-3xl p-8 mb-8 shadow-sm border border-gray-100">
            <h2 class="text-xl font-bold text-gray-900 mb-4 flex items-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mr-2 text-rose-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
              </svg>
              About this place
            </h2>
            <p class="text-gray-600 leading-relaxed"><%= home.description || 'Welcome to this beautiful property! Perfect for travelers looking for a comfortable and convenient stay. This space offers everything you need for a memorable trip.' %></p>
          </div>

          <!-- Amenities -->
          <% if (home.amenities && home.amenities.length > 0) { %>
            <div class="bg-white rounded-3xl p-8 mb-8 shadow-sm border border-gray-100">
              <h2 class="text-xl font-bold text-gray-900 mb-6 flex items-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mr-2 text-rose-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                What this place offers
              </h2>
              <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
                <% const amenityData = {
                  wifi: { icon: '📶', color: 'bg-blue-100 text-blue-700' },
                  pool: { icon: '🏊', color: 'bg-cyan-100 text-cyan-700' },
                  parking: { icon: '🚗', color: 'bg-gray-100 text-gray-700' },
                  ac: { icon: '❄️', color: 'bg-sky-100 text-sky-700' },
                  kitchen: { icon: '🍳', color: 'bg-orange-100 text-orange-700' },
                  washer: { icon: '🧺', color: 'bg-purple-100 text-purple-700' },
                  tv: { icon: '📺', color: 'bg-indigo-100 text-indigo-700' },
                  workspace: { icon: '💼', color: 'bg-amber-100 text-amber-700' },
                  gym: { icon: '🏋️', color: 'bg-red-100 text-red-700' },
                  'hot tub': { icon: '🛁', color: 'bg-pink-100 text-pink-700' },
                  fireplace: { icon: '🔥', color: 'bg-orange-100 text-orange-700' },
                  balcony: { icon: '🌅', color: 'bg-teal-100 text-teal-700' }
                }; %>
                <% home.amenities.forEach(amenity => { 
                  const data = amenityData[amenity.toLowerCase()] || { icon: '✓', color: 'bg-gray-100 text-gray-700' };
                %>
                  <div class="flex items-center p-3 rounded-xl <%= data.color %>">
                    <span class="text-xl mr-3"><%= data.icon %></span>
                    <span class="font-medium capitalize"><%= amenity %></span>
                  </div>
                <% }); %>
              </div>
            </div>
          <% } %>

          <!-- Location -->
          <div class="bg-white rounded-3xl p-8 shadow-sm border border-gray-100">
            <h2 class="text-xl font-bold text-gray-900 mb-4 flex items-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mr-2 text-rose-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              </svg>
              Location
            </h2>
            <p class="text-gray-600 text-lg"><%= home.location %></p>
          </div>
        </div>

        <!-- Sidebar - Booking Card -->
        <div class="lg:col-span-1">
          <div class="sticky top-24">
            <div class="bg-white rounded-3xl shadow-xl border border-gray-100 overflow-hidden">
              <!-- Price Header -->
              <div class="p-6 border-b border-gray-100">
                <div class="flex items-baseline justify-between">
                  <div>
                    <span class="text-3xl font-bold text-gray-900">₹<%= home.price.toLocaleString('en-IN') %></span>
                    <span class="text-gray-500 ml-1">/ night</span>
                  </div>
                  <div class="flex items-center text-sm text-gray-600">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-amber-400 mr-1" viewBox="0 0 20 20" fill="currentColor">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                    <span><%= home.rating %></span>
                  </div>
                </div>
                
                <!-- Dynamic Pricing Badge -->
                <div class="mt-3 px-3 py-2 bg-blue-50 rounded-lg text-sm text-blue-700 flex items-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
                  </svg>
                  <span>Dynamic pricing available</span>
                </div>
              </div>
              
              <!-- Availability Status -->
              <%
                var today = new Date(); today.setHours(0,0,0,0);
                var isUnavailableToday = false;
                if (typeof upcomingBookings !== 'undefined' && upcomingBookings && upcomingBookings.length > 0) {
                  isUnavailableToday = upcomingBookings.some(function(b) {
                    var bIn = new Date(b.checkInDate);
                    var bOut = new Date(b.checkOutDate);
                    return bIn <= today && bOut > today;
                  });
                }
              %>
              
              <div class="px-6 py-4 <%= isUnavailableToday ? 'bg-red-50' : 'bg-emerald-50' %>">
                <div class="flex items-center">
                  <% if (isUnavailableToday) { %>
                    <div class="w-3 h-3 bg-red-500 rounded-full mr-2"></div>
                    <span class="font-medium text-red-700">Currently Booked</span>
                  <% } else { %>
                    <div class="w-3 h-3 bg-emerald-500 rounded-full mr-2 animate-pulse"></div>
                    <span class="font-medium text-emerald-700">Available Now</span>
                  <% } %>
                </div>
              </div>
              
              <!-- Booking Form -->
              <div class="p-6">
                <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
                  <div class="mb-4 p-3 bg-red-50 border border-red-200 rounded-xl text-sm text-red-700 flex items-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <%= errorMessage %>
                  </div>
                <% } %>
                
                <form action="/bookings/create" method="POST" class="space-y-4">
                  <input type="hidden" name="listingId" value="<%= home._id %>" />
                  
                  <div class="grid grid-cols-2 gap-3">
                    <div>
                      <label for="checkInDate" class="block text-xs font-semibold text-gray-700 mb-1.5 uppercase tracking-wider">Check-in</label>
                      <input
                        type="date"
                        id="checkInDate"
                        name="checkInDate"
                        required
                        min="<%= new Date().toISOString().split('T')[0] %>"
                        class="w-full px-3 py-3 rounded-xl border-2 border-gray-200 focus:border-rose-500 focus:ring-0 text-gray-800 input-modern"
                      />
                    </div>
                    <div>
                      <label for="checkOutDate" class="block text-xs font-semibold text-gray-700 mb-1.5 uppercase tracking-wider">Check-out</label>
                      <input
                        type="date"
                        id="checkOutDate"
                        name="checkOutDate"
                        required
                        min="<%= new Date().toISOString().split('T')[0] %>"
                        class="w-full px-3 py-3 rounded-xl border-2 border-gray-200 focus:border-rose-500 focus:ring-0 text-gray-800 input-modern"
                      />
                    </div>
                  </div>
                  
                  <!-- Price Estimate (will be updated via JS) -->
                  <div id="priceEstimate" class="hidden p-4 bg-gray-50 rounded-xl space-y-2">
                    <div class="flex justify-between text-sm">
                      <span class="text-gray-600">₹<%= home.price.toLocaleString('en-IN') %> × <span id="nightsCount">0</span> nights</span>
                      <span class="font-medium" id="subtotal">₹0</span>
                    </div>
                    <div id="dynamicPricingNote" class="hidden text-xs text-blue-600 flex items-center">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                      </svg>
                      Final price may vary based on dynamic pricing
                    </div>
                    <div class="border-t border-gray-200 pt-2 flex justify-between font-semibold">
                      <span>Estimated Total</span>
                      <span id="totalEstimate">₹0</span>
                    </div>
                  </div>
                  
                  <button type="submit" class="w-full gradient-animated text-white py-4 rounded-xl font-semibold hover:shadow-lg transition-all duration-300 btn-pulse">
                    Reserve
                  </button>
                  
                  <p class="text-center text-xs text-gray-500">You won't be charged yet</p>
                  
                  <% if (!isLoggedIn) { %>
                    <p class="text-center text-xs text-gray-500 flex items-center justify-center">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                      </svg>
                      You'll be asked to log in
                    </p>
                  <% } else if (user && user.userType === 'host') { %>
                    <p class="text-center text-xs text-amber-600 flex items-center justify-center">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                      </svg>
                      Hosts cannot book properties
                    </p>
                  <% } %>
                </form>
              </div>
            </div>
            
            <!-- Report Link -->
            <div class="mt-4 text-center">
              <button class="text-sm text-gray-500 hover:text-gray-700 transition flex items-center justify-center mx-auto">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-3 6 3 6h-8.5l-1-1H5a2 2 0 00-2 2zm9-13.5V9"/>
                </svg>
                Report this listing
              </button>
            </div>
          </div>
        </div>
      </div>
    </main>
    
    <script>
      // Date validation and price estimate
      const checkIn = document.getElementById('checkInDate');
      const checkOut = document.getElementById('checkOutDate');
      const priceEstimate = document.getElementById('priceEstimate');
      const nightsCount = document.getElementById('nightsCount');
      const subtotal = document.getElementById('subtotal');
      const totalEstimate = document.getElementById('totalEstimate');
      const dynamicPricingNote = document.getElementById('dynamicPricingNote');
      const basePrice = <%= home.price %>;
      
      function updateEstimate() {
        if (checkIn.value && checkOut.value) {
          const start = new Date(checkIn.value);
          const end = new Date(checkOut.value);
          const nights = Math.ceil((end - start) / (1000 * 60 * 60 * 24));
          
          if (nights > 0) {
            priceEstimate.classList.remove('hidden');
            nightsCount.textContent = nights;
            const total = basePrice * nights;
            subtotal.textContent = '₹' + total.toLocaleString('en-IN');
            totalEstimate.textContent = '₹' + total.toLocaleString('en-IN');
            dynamicPricingNote.classList.remove('hidden');
          } else {
            priceEstimate.classList.add('hidden');
          }
        } else {
          priceEstimate.classList.add('hidden');
        }
      }
      
      checkIn.addEventListener('change', () => {
        if (checkIn.value) {
          const next = new Date(checkIn.value);
          next.setDate(next.getDate() + 1);
          checkOut.min = next.toISOString().split('T')[0];
          if (checkOut.value && checkOut.value <= checkIn.value) {
            checkOut.value = checkOut.min;
          }
        }
        updateEstimate();
      });
      
      checkOut.addEventListener('change', updateEstimate);
    </script>
  </body>
</html>
