<%- include('../partials/head') %>
  </head>
  <body class="bg-gray-50 antialiased">
    <%- include('../partials/nav') %>
    
    <main id="main-content" role="main" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8 lg:py-10 fade-in">
      <!-- Breadcrumb -->
      <nav class="mb-4 sm:mb-6 overflow-x-auto">
        <ol class="flex items-center space-x-2 text-xs sm:text-sm text-gray-500 whitespace-nowrap">
          <li><a href="/" class="hover:text-rose-500 transition">Home</a></li>
          <li><span>/</span></li>
          <li><a href="/homes" class="hover:text-rose-500 transition">Explore</a></li>
          <li><span>/</span></li>
          <li class="text-gray-900 font-medium truncate max-w-[150px] sm:max-w-[200px]"><%= home.houseName %></li>
        </ol>
      </nav>

      <!-- Mobile Booking Card (shown on top for mobile) -->
      <div class="lg:hidden mb-6">
        <div class="bg-white rounded-2xl shadow-lg border border-gray-100 p-4">
          <div class="flex items-baseline justify-between mb-3">
            <div>
              <span class="text-2xl font-bold text-gray-900">₹<%= home.price.toLocaleString('en-IN') %></span>
              <span class="text-gray-500 text-sm ml-1">/ night</span>
            </div>
            <div class="flex items-center text-sm text-gray-600">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-amber-400 mr-1" viewBox="0 0 20 20" fill="currentColor">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
              <span><%= home.rating %></span>
            </div>
          </div>
          <a href="#booking-form" class="block w-full bg-rose-500 hover:bg-rose-600 text-white py-3 rounded-xl font-semibold text-center transition-colors">
            Check availability
          </a>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-8">
        <!-- Main Content -->
        <div class="lg:col-span-2">
          <!-- Property Header -->
          <div class="mb-6">
            <div class="flex items-start justify-between mb-4">
              <div>
                <% if (home.propertyType) { %>
                  <span class="inline-block px-3 py-1 bg-rose-100 text-rose-700 text-xs font-semibold rounded-full mb-3 capitalize">
                    <%= home.propertyType %>
                  </span>
                <% } %>
                <h1 class="text-3xl md:text-4xl font-bold text-gray-900 font-display"><%= home.houseName %></h1>
              </div>
              <div class="text-right">
                <%- include('../partials/favourite') %>
              </div>
            </div>
            
            <div class="flex flex-wrap items-center gap-4 text-gray-600">
              <div class="flex items-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-1.5 text-amber-400" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
                <span class="font-semibold text-gray-900"><%= home.rating %></span>
              </div>
              <span class="text-gray-300">•</span>
              <div class="flex items-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-1.5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                </svg>
                <span><%= home.location %></span>
              </div>
            </div>
          </div>

          <!-- Property Image -->
          <div class="rounded-3xl overflow-hidden mb-8 shadow-lg relative group cursor-pointer" id="mainImageContainer" role="button" aria-label="Click to view fullscreen">
            <% if (home.photo) { %>
              <img src="/<%= home.photo %>" alt="<%= home.houseName %>" class="w-full h-[400px] md:h-[500px] object-cover transition-transform duration-500 group-hover:scale-105" id="mainImage"
                   onerror="this.onerror=null; this.src='/images/house1.png';">
            <% } else { %>
              <img src="/images/house1.png" alt="<%= home.houseName %>" class="w-full h-[400px] md:h-[500px] object-cover transition-transform duration-500 group-hover:scale-105" id="mainImage">
            <% } %>
            <!-- Fullscreen button -->
            <button onclick="openImageModal()" class="absolute bottom-4 right-4 flex items-center gap-2 px-4 py-2 bg-white/90 backdrop-blur-sm rounded-lg shadow-lg hover:bg-white transition-all text-sm font-medium text-gray-700">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/>
              </svg>
              View Full Screen
            </button>
            <!-- Image overlay on hover -->
            <div class="absolute inset-0 bg-black/0 group-hover:bg-black/10 transition-colors duration-300 pointer-events-none"></div>
          </div>

          <!-- Fullscreen Image Modal -->
          <div id="imageModal" class="fixed inset-0 z-[9999] bg-black/95 hidden opacity-0 transition-opacity duration-300">
            <button onclick="closeImageModal()" class="absolute top-4 right-4 z-10 p-3 bg-white/10 hover:bg-white/20 rounded-full transition-all" aria-label="Close fullscreen view">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
              </svg>
            </button>
            <div class="flex items-center justify-center h-full p-4">
              <img src="/<%= home.photo %>" alt="<%= home.houseName %>" class="max-w-full max-h-full object-contain rounded-lg shadow-2xl" id="modalImage">
            </div>
            <div class="absolute bottom-6 left-0 right-0 text-center">
              <p class="text-white/80 text-sm">Press ESC or click × to close</p>
            </div>
          </div>

          <!-- Quick Stats -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 mb-6 sm:mb-8">
            <div class="bg-white rounded-xl sm:rounded-2xl p-3 sm:p-5 text-center shadow-sm border border-gray-100">
              <div class="w-10 h-10 sm:w-12 sm:h-12 bg-rose-100 rounded-lg sm:rounded-xl flex items-center justify-center mx-auto mb-2 sm:mb-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 sm:h-6 sm:w-6 text-rose-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                </svg>
              </div>
              <p class="text-2xl font-bold text-gray-900"><%= home.maxGuests || 2 %></p>
              <p class="text-sm text-gray-500">Guests</p>
            </div>
            <div class="bg-white rounded-2xl p-5 text-center shadow-sm border border-gray-100">
              <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center mx-auto mb-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                </svg>
              </div>
              <p class="text-2xl font-bold text-gray-900"><%= home.bedrooms || 1 %></p>
              <p class="text-sm text-gray-500">Bedrooms</p>
            </div>
            <div class="bg-white rounded-2xl p-5 text-center shadow-sm border border-gray-100">
              <div class="w-12 h-12 bg-emerald-100 rounded-xl flex items-center justify-center mx-auto mb-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 14v6m-3-3h6M6 10h2a4 4 0 014 4v1a3 3 0 01-3 3H5a3 3 0 01-3-3v-1a4 4 0 014-4zm0 0V6a4 4 0 014-4h1a2 2 0 012 2v2"/>
                </svg>
              </div>
              <p class="text-2xl font-bold text-gray-900"><%= home.bathrooms || 1 %></p>
              <p class="text-sm text-gray-500">Bathrooms</p>
            </div>
            <div class="bg-white rounded-2xl p-5 text-center shadow-sm border border-gray-100">
              <div class="w-12 h-12 bg-amber-100 rounded-xl flex items-center justify-center mx-auto mb-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-amber-600" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              </div>
              <p class="text-2xl font-bold text-gray-900"><%= home.rating %></p>
              <p class="text-sm text-gray-500">Rating</p>
            </div>
          </div>

          <!-- Description -->
          <div class="bg-white rounded-3xl p-8 mb-8 shadow-sm border border-gray-100">
            <h2 class="text-xl font-bold text-gray-900 mb-4 flex items-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mr-2 text-rose-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
              </svg>
              About this place
            </h2>
            <p class="text-gray-600 leading-relaxed"><%= home.description || 'Welcome to this beautiful property! Perfect for travelers looking for a comfortable and convenient stay. This space offers everything you need for a memorable trip.' %></p>
          </div>

          <!-- Amenities -->
          <% if (home.amenities && home.amenities.length > 0) { %>
            <div class="bg-white rounded-3xl p-8 mb-8 shadow-sm border border-gray-100">
              <h2 class="text-xl font-bold text-gray-900 mb-6 flex items-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mr-2 text-rose-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                What this place offers
              </h2>
              <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
                <% const amenityData = {
                  wifi: { icon: '📶', color: 'bg-blue-100 text-blue-700' },
                  pool: { icon: '🏊', color: 'bg-cyan-100 text-cyan-700' },
                  parking: { icon: '🚗', color: 'bg-gray-100 text-gray-700' },
                  ac: { icon: '❄️', color: 'bg-sky-100 text-sky-700' },
                  kitchen: { icon: '🍳', color: 'bg-orange-100 text-orange-700' },
                  washer: { icon: '🧺', color: 'bg-purple-100 text-purple-700' },
                  tv: { icon: '📺', color: 'bg-indigo-100 text-indigo-700' },
                  workspace: { icon: '💼', color: 'bg-amber-100 text-amber-700' },
                  gym: { icon: '🏋️', color: 'bg-red-100 text-red-700' },
                  'hot tub': { icon: '🛁', color: 'bg-pink-100 text-pink-700' },
                  fireplace: { icon: '🔥', color: 'bg-orange-100 text-orange-700' },
                  balcony: { icon: '🌅', color: 'bg-teal-100 text-teal-700' }
                }; %>
                <% home.amenities.forEach(amenity => { 
                  const data = amenityData[amenity.toLowerCase()] || { icon: '✓', color: 'bg-gray-100 text-gray-700' };
                %>
                  <div class="flex items-center p-3 rounded-xl <%= data.color %>">
                    <span class="text-xl mr-3"><%= data.icon %></span>
                    <span class="font-medium capitalize"><%= amenity %></span>
                  </div>
                <% }); %>
              </div>
            </div>
          <% } %>

          <!-- Location -->
          <div class="bg-white rounded-3xl p-8 shadow-sm border border-gray-100">
            <h2 class="text-xl font-bold text-gray-900 mb-4 flex items-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mr-2 text-rose-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              </svg>
              Location
            </h2>
            <p class="text-gray-600 text-lg"><%= home.location %></p>
          </div>
        </div>

        <!-- Sidebar - Booking Card -->
        <div class="lg:col-span-1 hidden lg:block" id="booking-form">
          <div class="sticky top-24">
            <div class="bg-white rounded-3xl shadow-xl border border-gray-100 overflow-hidden">
              <!-- Price Header -->
              <div class="p-6 border-b border-gray-100">
                <div class="flex items-baseline justify-between">
                  <div>
                    <span class="text-3xl font-bold text-gray-900">₹<%= home.price.toLocaleString('en-IN') %></span>
                    <span class="text-gray-500 ml-1">/ night</span>
                  </div>
                  <div class="flex items-center text-sm text-gray-600">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-amber-400 mr-1" viewBox="0 0 20 20" fill="currentColor">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                    <span><%= home.rating %></span>
                  </div>
                </div>
                
                <!-- Dynamic Pricing Badge -->
                <div class="mt-3 px-3 py-2 bg-blue-50 rounded-lg text-sm text-blue-700 flex items-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
                  </svg>
                  <span>Dynamic pricing available</span>
                </div>
              </div>
              
              <!-- Availability Status -->
              <%
                var today = new Date(); today.setHours(0,0,0,0);
                var isUnavailableToday = false;
                if (typeof upcomingBookings !== 'undefined' && upcomingBookings && upcomingBookings.length > 0) {
                  isUnavailableToday = upcomingBookings.some(function(b) {
                    var bIn = new Date(b.checkInDate);
                    var bOut = new Date(b.checkOutDate);
                    return bIn <= today && bOut > today;
                  });
                }
              %>
              
              <div class="px-6 py-4 <%= isUnavailableToday ? 'bg-red-50' : 'bg-emerald-50' %>">
                <div class="flex items-center">
                  <% if (isUnavailableToday) { %>
                    <div class="w-3 h-3 bg-red-500 rounded-full mr-2"></div>
                    <span class="font-medium text-red-700">Currently Booked</span>
                  <% } else { %>
                    <div class="w-3 h-3 bg-emerald-500 rounded-full mr-2 animate-pulse"></div>
                    <span class="font-medium text-emerald-700">Available Now</span>
                  <% } %>
                </div>
              </div>
              
              <!-- Booking Form -->
              <div class="p-6">
                <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
                  <div class="mb-4 p-3 bg-red-50 border border-red-200 rounded-xl text-sm text-red-700 flex items-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <%= errorMessage %>
                  </div>
                <% } %>
                
                <form action="/bookings/create" method="POST" class="space-y-4">
                  <input type="hidden" name="listingId" value="<%= home._id %>" />
                  
                  <div class="grid grid-cols-2 gap-3">
                    <div>
                      <label for="checkInDate" class="block text-xs font-semibold text-gray-700 mb-1.5 uppercase tracking-wider">Check-in</label>
                      <input
                        type="date"
                        id="checkInDate"
                        name="checkInDate"
                        required
                        min="<%= new Date().toISOString().split('T')[0] %>"
                        class="w-full px-3 py-3 rounded-xl border-2 border-gray-200 focus:border-rose-500 focus:ring-0 text-gray-800 input-modern"
                      />
                    </div>
                    <div>
                      <label for="checkOutDate" class="block text-xs font-semibold text-gray-700 mb-1.5 uppercase tracking-wider">Check-out</label>
                      <input
                        type="date"
                        id="checkOutDate"
                        name="checkOutDate"
                        required
                        min="<%= new Date().toISOString().split('T')[0] %>"
                        class="w-full px-3 py-3 rounded-xl border-2 border-gray-200 focus:border-rose-500 focus:ring-0 text-gray-800 input-modern"
                      />
                    </div>
                  </div>
                  
                  <!-- Price Estimate (will be updated via JS) -->
                  <div id="priceEstimate" class="hidden p-4 bg-gray-50 rounded-xl space-y-2">
                    <!-- Dynamic Pricing Alert - Higher Price -->
                    <div id="higherPriceAlert" class="hidden mb-2 p-3 bg-amber-50 rounded-lg border border-amber-200">
                      <div class="flex items-center gap-2">
                        <svg class="w-5 h-5 text-amber-600 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                          <path fill-rule="evenodd" d="M12.395 2.553a1 1 0 00-1.45-.385c-.345.23-.614.558-.822.88-.214.33-.403.713-.57 1.116-.334.804-.614 1.768-.84 2.734a31.365 31.365 0 00-.613 3.58 2.64 2.64 0 01-.945-1.067c-.328-.68-.398-1.534-.398-2.654A1 1 0 005.05 6.05 6.981 6.981 0 003 11a7 7 0 1011.95-4.95c-.592-.591-.98-.985-1.348-1.467-.363-.476-.724-1.063-1.207-2.03zM12.12 15.12A3 3 0 017 13s.879.5 2.5.5c0-1 .5-4 1.25-4.5.5 1 .786 1.293 1.371 1.879A2.99 2.99 0 0113 13a2.99 2.99 0 01-.879 2.121z" clip-rule="evenodd"/>
                        </svg>
                        <div>
                          <p class="text-sm font-semibold text-amber-800">Peak Season Rates</p>
                          <p id="higherPriceText" class="text-xs text-amber-700"></p>
                        </div>
                      </div>
                    </div>
                    
                    <!-- Dynamic Pricing Alert - Lower Price (Discount) -->
                    <div id="lowerPriceAlert" class="hidden mb-2 p-3 bg-green-50 rounded-lg border border-green-200">
                      <div class="flex items-center gap-2">
                        <svg class="w-5 h-5 text-green-600 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                        </svg>
                        <div>
                          <p class="text-sm font-semibold text-green-800">You're Saving!</p>
                          <p id="lowerPriceText" class="text-xs text-green-700"></p>
                        </div>
                      </div>
                    </div>
                    
                    <div class="flex justify-between text-sm">
                      <span class="text-gray-600">₹<span id="avgPricePerNight"><%= home.price.toLocaleString('en-IN') %></span> × <span id="nightsCount">0</span> nights</span>
                      <span class="font-medium" id="subtotal">₹0</span>
                    </div>
                    
                    <!-- Original Price (shown when different) -->
                    <div id="originalPriceRow" class="hidden flex justify-between text-sm">
                      <span class="text-gray-400">Original price</span>
                      <span class="text-gray-400 line-through" id="originalPrice">₹0</span>
                    </div>
                    
                    <div class="border-t border-gray-200 pt-2 flex justify-between font-semibold">
                      <span>Estimated Total</span>
                      <span id="totalEstimate">₹0</span>
                    </div>
                  </div>
                  
                  <button type="submit" class="w-full bg-rose-500 hover:bg-rose-600 text-white py-4 rounded-xl font-semibold transition-colors">
                    Reserve
                  </button>
                  
                  <p class="text-center text-xs text-gray-500">You won't be charged yet</p>
                  
                  <% if (!isLoggedIn) { %>
                    <p class="text-center text-xs text-gray-500 flex items-center justify-center">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                      </svg>
                      You'll be asked to log in
                    </p>
                  <% } else if (user && user.userType === 'host') { %>
                    <p class="text-center text-xs text-amber-600 flex items-center justify-center">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                      </svg>
                      Hosts cannot book properties
                    </p>
                  <% } %>
                </form>
              </div>
            </div>
            
            <!-- Report Link -->
            <div class="mt-4 text-center">
              <button class="text-sm text-gray-500 hover:text-gray-700 transition flex items-center justify-center mx-auto">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-3 6 3 6h-8.5l-1-1H5a2 2 0 00-2 2zm9-13.5V9"/>
                </svg>
                Report this listing
              </button>
            </div>
          </div>
        </div>
      </div>
    </main>
    
    <!-- Mobile Sticky Booking Bar -->
    <div class="lg:hidden fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200 p-4 shadow-lg z-40 safe-area-bottom">
      <div class="flex items-center justify-between gap-4">
        <div>
          <span class="text-lg font-bold text-gray-900">₹<%= home.price.toLocaleString('en-IN') %></span>
          <span class="text-gray-500 text-sm ml-1">/ night</span>
        </div>
        <a href="#booking-form" class="bg-rose-500 hover:bg-rose-600 text-white px-6 py-3 rounded-xl font-semibold text-sm transition-colors flex-shrink-0">
          Reserve
        </a>
      </div>
    </div>
    
    <script>
      // Fullscreen Image Modal
      const imageModal = document.getElementById('imageModal');
      const mainImageContainer = document.getElementById('mainImageContainer');
      
      function openImageModal() {
        imageModal.classList.remove('hidden');
        setTimeout(() => imageModal.classList.add('opacity-100'), 10);
        document.body.style.overflow = 'hidden';
      }
      
      function closeImageModal() {
        imageModal.classList.remove('opacity-100');
        setTimeout(() => {
          imageModal.classList.add('hidden');
          document.body.style.overflow = '';
        }, 300);
      }
      
      // Close on ESC key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !imageModal.classList.contains('hidden')) {
          closeImageModal();
        }
      });
      
      // Close on click outside image
      imageModal.addEventListener('click', (e) => {
        if (e.target === imageModal) {
          closeImageModal();
        }
      });
      
      // Click on main image to open modal
      mainImageContainer.addEventListener('click', (e) => {
        if (!e.target.closest('button')) {
          openImageModal();
        }
      });

      // Date validation and price estimate
      const checkIn = document.getElementById('checkInDate');
      const checkOut = document.getElementById('checkOutDate');
      const priceEstimate = document.getElementById('priceEstimate');
      const nightsCount = document.getElementById('nightsCount');
      const avgPricePerNight = document.getElementById('avgPricePerNight');
      const subtotal = document.getElementById('subtotal');
      const totalEstimate = document.getElementById('totalEstimate');
      const higherPriceAlert = document.getElementById('higherPriceAlert');
      const lowerPriceAlert = document.getElementById('lowerPriceAlert');
      const originalPriceRow = document.getElementById('originalPriceRow');
      const basePrice = <%= home.price %>;
      const listingId = '<%= home._id %>';
      
      async function updateEstimate() {
        if (checkIn.value && checkOut.value) {
          const start = new Date(checkIn.value);
          const end = new Date(checkOut.value);
          const nights = Math.ceil((end - start) / (1000 * 60 * 60 * 24));
          
          if (nights > 0) {
            priceEstimate.classList.remove('hidden');
            nightsCount.textContent = nights;
            
            // Hide alerts initially
            higherPriceAlert.classList.add('hidden');
            lowerPriceAlert.classList.add('hidden');
            originalPriceRow.classList.add('hidden');
            
            try {
              // Call pricing API for dynamic pricing
              const response = await fetch(`/api/pricing/calculate?listingId=${listingId}&checkIn=${checkIn.value}&checkOut=${checkOut.value}`);
              const data = await response.json();
              
              const finalPrice = data.totalPrice;
              const avgPrice = data.averagePricePerNight;
              const originalTotal = data.originalTotal;
              const difference = finalPrice - originalTotal;
              const percentChange = Math.round((difference / originalTotal) * 100);
              
              // Update display
              avgPricePerNight.textContent = avgPrice.toLocaleString('en-IN');
              subtotal.textContent = '₹' + finalPrice.toLocaleString('en-IN');
              totalEstimate.textContent = '₹' + finalPrice.toLocaleString('en-IN');
              
              // Show pricing alerts if rules are applied
              if (data.appliedRules && data.appliedRules.length > 0) {
                const ruleNames = data.appliedRules.map(r => r.name).join(', ');
                
                // Show original price row
                originalPriceRow.classList.remove('hidden');
                document.getElementById('originalPrice').textContent = '₹' + originalTotal.toLocaleString('en-IN');
                
                if (difference > 0) {
                  // Price is HIGHER
                  document.getElementById('higherPriceText').textContent = 
                    `${ruleNames} (+${percentChange}%) - ₹${Math.abs(difference).toLocaleString('en-IN')} extra`;
                  higherPriceAlert.classList.remove('hidden');
                } else if (difference < 0) {
                  // Price is LOWER (discount)
                  document.getElementById('lowerPriceText').textContent = 
                    `${ruleNames} (-${Math.abs(percentChange)}%) - Save ₹${Math.abs(difference).toLocaleString('en-IN')}!`;
                  lowerPriceAlert.classList.remove('hidden');
                }
              }
            } catch (error) {
              // Fallback to basic calculation if API fails
              const total = basePrice * nights;
              avgPricePerNight.textContent = basePrice.toLocaleString('en-IN');
              subtotal.textContent = '₹' + total.toLocaleString('en-IN');
              totalEstimate.textContent = '₹' + total.toLocaleString('en-IN');
            }
          } else {
            priceEstimate.classList.add('hidden');
          }
        } else {
          priceEstimate.classList.add('hidden');
        }
      }
      
      checkIn.addEventListener('change', () => {
        if (checkIn.value) {
          const next = new Date(checkIn.value);
          next.setDate(next.getDate() + 1);
          checkOut.min = next.toISOString().split('T')[0];
          if (checkOut.value && checkOut.value <= checkIn.value) {
            checkOut.value = checkOut.min;
          }
        }
        updateEstimate();
      });
      
      checkOut.addEventListener('change', updateEstimate);
      
      // Smooth scroll for booking card on mobile
      const bookingCard = document.querySelector('.sticky');
      let lastScrollY = window.scrollY;
      
      if (window.innerWidth < 1024 && bookingCard) {
        // Add floating book button for mobile
        const floatingBtn = document.createElement('div');
        floatingBtn.className = 'lg:hidden fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200 p-4 z-40 flex items-center justify-between';
        floatingBtn.innerHTML = \`
          <div>
            <span class="text-lg font-bold text-gray-900">₹<%= home.price.toLocaleString('en-IN') %></span>
            <span class="text-gray-500 text-sm">/night</span>
          </div>
          <button onclick="document.getElementById('checkInDate').scrollIntoView({ behavior: 'smooth', block: 'center' })" class="bg-rose-500 hover:bg-rose-600 text-white px-8 py-3 rounded-xl font-semibold transition-colors">
            Reserve
          </button>
        \`;
        document.body.appendChild(floatingBtn);
        document.body.style.paddingBottom = '80px';
      }
    </script>
    
    <%- include('../partials/footer') %>
  </body>
</html>
