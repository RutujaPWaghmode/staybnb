<%- include('../partials/head') %>
  </head>
  <body class="bg-gray-50 antialiased">
    <%- include('../partials/nav') %>
    
    <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 fade-in">
      <!-- Page Header -->
      <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-10">
        <div>
          <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-2">My Trips</h1>
          <p class="text-gray-500">Manage your bookings and upcoming stays</p>
        </div>
        <div class="mt-4 md:mt-0 flex items-center space-x-3">
          <a href="/bookings/policy" class="inline-flex items-center px-4 py-2 border border-gray-200 rounded-xl text-sm font-medium text-gray-700 hover:bg-gray-50 transition">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            Cancellation Policy
          </a>
          <a href="/homes" class="inline-flex items-center px-4 py-2 gradient-animated text-white rounded-xl text-sm font-medium hover:shadow-lg transition">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            Book New Stay
          </a>
        </div>
      </div>

      <!-- Success/Cancel Messages -->
      <% if (typeof successMessage !== 'undefined' && successMessage) { %>
        <div class="mb-6 p-4 bg-emerald-50 border border-emerald-200 rounded-2xl flex items-center slide-up">
          <div class="w-10 h-10 bg-emerald-100 rounded-full flex items-center justify-center mr-4 shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <p class="text-emerald-800 font-medium"><%= successMessage %></p>
        </div>
      <% } %>

      <% if (typeof cancelled !== 'undefined' && cancelled) { %>
        <div class="mb-6 p-4 bg-amber-50 border border-amber-200 rounded-2xl flex items-center slide-up">
          <div class="w-10 h-10 bg-amber-100 rounded-full flex items-center justify-center mr-4 shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
          </div>
          <p class="text-amber-800 font-medium">Booking cancelled successfully. Refund will be processed if applicable.</p>
        </div>
      <% } %>

      <% if (!bookings || bookings.length === 0) { %>
        <!-- Empty State -->
        <div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-12 text-center">
          <div class="w-24 h-24 bg-rose-100 rounded-full flex items-center justify-center mx-auto mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-rose-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-2">No trips yet</h3>
          <p class="text-gray-500 mb-8 max-w-md mx-auto">Time to plan your next adventure! Browse our amazing properties and book your perfect stay.</p>
          <a href="/homes" class="inline-flex items-center px-6 py-3 gradient-animated text-white rounded-xl font-semibold hover:shadow-lg transition">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
            Explore Stays
          </a>
        </div>
      <% } else { %>
        <!-- Bookings Grid -->
        <div class="space-y-6">
          <% bookings.forEach(function(b, index) { %>
            <% var listing = b.listingId; %>
            <%
              var now = new Date();
              var checkIn = new Date(b.checkInDate);
              var checkOut = new Date(b.checkOutDate);
              var canCancel = ['confirmed', 'pending'].includes(b.bookingStatus) && now < checkIn;
              var isUpcoming = now < checkIn && b.bookingStatus === 'confirmed';
              var isOngoing = now >= checkIn && now < checkOut && b.bookingStatus === 'confirmed';
              var isPast = now >= checkOut || b.bookingStatus === 'cancelled' || b.bookingStatus === 'completed';
            %>
            
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-lg transition-all duration-300 card-hover" style="animation-delay: <%= index * 100 %>ms">
              <div class="flex flex-col md:flex-row">
                <!-- Property Image -->
                <div class="relative md:w-72 lg:w-80 shrink-0">
                  <% if (listing) { %>
                    <img src="<%= listing.photo %>" alt="<%= listing.houseName %>" class="w-full h-48 md:h-full object-cover">
                  <% } else { %>
                    <div class="w-full h-48 md:h-full bg-gray-200 flex items-center justify-center">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                      </svg>
                    </div>
                  <% } %>
                  
                  <!-- Status Badge -->
                  <div class="absolute top-4 left-4">
                    <% if (b.bookingStatus === 'cancelled') { %>
                      <span class="px-3 py-1.5 bg-red-500 text-white text-xs font-bold rounded-full shadow-lg">CANCELLED</span>
                    <% } else if (isOngoing) { %>
                      <span class="px-3 py-1.5 bg-emerald-500 text-white text-xs font-bold rounded-full shadow-lg flex items-center">
                        <span class="w-2 h-2 bg-white rounded-full mr-1.5 animate-pulse"></span>
                        ONGOING
                      </span>
                    <% } else if (isUpcoming) { %>
                      <span class="px-3 py-1.5 bg-blue-500 text-white text-xs font-bold rounded-full shadow-lg">UPCOMING</span>
                    <% } else if (isPast) { %>
                      <span class="px-3 py-1.5 bg-gray-500 text-white text-xs font-bold rounded-full shadow-lg">COMPLETED</span>
                    <% } else if (b.bookingStatus === 'pending') { %>
                      <span class="px-3 py-1.5 bg-amber-500 text-white text-xs font-bold rounded-full shadow-lg">PENDING</span>
                    <% } %>
                  </div>
                </div>
                
                <!-- Booking Details -->
                <div class="flex-1 p-6">
                  <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between">
                    <div class="flex-1">
                      <!-- Property Name -->
                      <h3 class="text-xl font-bold text-gray-900 mb-2">
                        <%= listing ? listing.houseName : 'Listing no longer available' %>
                      </h3>
                      
                      <!-- Location -->
                      <% if (listing) { %>
                        <p class="text-gray-500 text-sm flex items-center mb-4">
                          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                          </svg>
                          <%= listing.location %>
                        </p>
                      <% } %>
                      
                      <!-- Dates -->
                      <div class="flex items-center space-x-6 mb-4">
                        <div class="flex items-center">
                          <div class="w-10 h-10 bg-rose-100 rounded-lg flex items-center justify-center mr-3">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-rose-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                            </svg>
                          </div>
                          <div>
                            <p class="text-xs text-gray-500">Check-in</p>
                            <p class="font-semibold text-gray-900"><%= b.checkInDate.toDateString() %></p>
                          </div>
                        </div>
                        
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                        </svg>
                        
                        <div class="flex items-center">
                          <div class="w-10 h-10 bg-rose-100 rounded-lg flex items-center justify-center mr-3">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-rose-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                            </svg>
                          </div>
                          <div>
                            <p class="text-xs text-gray-500">Check-out</p>
                            <p class="font-semibold text-gray-900"><%= b.checkOutDate.toDateString() %></p>
                          </div>
                        </div>
                      </div>
                      
                      <!-- Status Badges -->
                      <div class="flex flex-wrap gap-2">
                        <% if (b.paymentStatus) { %>
                          <span class="px-3 py-1 rounded-full text-xs font-semibold
                            <%= b.paymentStatus === 'completed' ? 'bg-emerald-100 text-emerald-700' :
                               b.paymentStatus === 'pending' ? 'bg-amber-100 text-amber-700' :
                               b.paymentStatus === 'refunded' ? 'bg-purple-100 text-purple-700' :
                               'bg-gray-100 text-gray-600' %>">
                            <% if (b.paymentStatus === 'completed') { %>✓ Paid<% } %>
                            <% if (b.paymentStatus === 'pending') { %>⏳ Payment Pending<% } %>
                            <% if (b.paymentStatus === 'refunded') { %>↩ Refunded<% } %>
                          </span>
                        <% } %>
                        
                        <% if (b.appliedPricingRules && b.appliedPricingRules.length > 0) { %>
                          <span class="px-3 py-1 rounded-full text-xs font-semibold bg-blue-100 text-blue-700">
                            💰 Dynamic Pricing
                          </span>
                        <% } %>
                      </div>
                    </div>
                    
                    <!-- Price & Actions -->
                    <div class="mt-6 lg:mt-0 lg:ml-6 lg:text-right">
                      <p class="text-3xl font-bold text-gray-900 mb-1">₹<%= b.totalPrice.toLocaleString('en-IN') %></p>
                      <% if (b.originalPrice && b.originalPrice !== b.totalPrice) { %>
                        <p class="text-sm text-gray-500 line-through">₹<%= b.originalPrice.toLocaleString('en-IN') %></p>
                      <% } %>
                      
                      <% if (b.bookingStatus === 'cancelled' && b.refundAmount > 0) { %>
                        <div class="mt-3 p-2 bg-purple-50 rounded-lg">
                          <p class="text-sm font-medium text-purple-700">
                            Refund: ₹<%= b.refundAmount.toLocaleString('en-IN') %>
                            <% if (b.refundStatus) { %>
                              <span class="text-purple-500">(<%= b.refundStatus %>)</span>
                            <% } %>
                          </p>
                        </div>
                      <% } %>
                    </div>
                  </div>
                  
                  <!-- Action Buttons -->
                  <div class="mt-6 pt-6 border-t border-gray-100 flex flex-wrap gap-3">
                    <a href="/bookings/<%= b._id %>" class="inline-flex items-center px-4 py-2 border-2 border-rose-500 text-rose-500 rounded-xl text-sm font-medium hover:bg-rose-50 transition">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                      </svg>
                      View Details
                    </a>
                    
                    <% if (b.paymentStatus === 'pending' && b.bookingStatus !== 'cancelled') { %>
                      <a href="/payment/<%= b._id %>" class="inline-flex items-center px-4 py-2 gradient-animated text-white rounded-xl text-sm font-medium hover:shadow-lg transition">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
                        </svg>
                        Complete Payment
                      </a>
                    <% } %>
                    
                    <% if (b.paymentStatus === 'completed' && b.bookingStatus !== 'cancelled') { %>
                      <a href="/invoice/<%= b._id %>" class="inline-flex items-center px-4 py-2 bg-gray-900 text-white rounded-xl text-sm font-medium hover:bg-gray-800 transition">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                        </svg>
                        Download Invoice
                      </a>
                    <% } %>
                    
                    <% if (canCancel) { %>
                      <a href="/bookings/<%= b._id %>/cancel" class="inline-flex items-center px-4 py-2 bg-red-50 text-red-600 border border-red-200 rounded-xl text-sm font-medium hover:bg-red-100 transition">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                        </svg>
                        Cancel Booking
                      </a>
                    <% } %>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </main>
  </body>
</html>
