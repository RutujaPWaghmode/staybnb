<%- include('../partials/head') %>
  </head>
  <body class="bg-white antialiased">
    <%- include('../partials/nav') %>
    
    <main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8">
      <!-- Page Header -->
      <div class="mb-6 sm:mb-8">
        <h1 class="text-xl sm:text-2xl font-semibold text-gray-900">Trips</h1>
      </div>

      <!-- Success/Cancel Messages -->
      <% if (typeof successMessage !== 'undefined' && successMessage) { %>
        <div class="mb-6 p-4 bg-emerald-50 border border-emerald-200 rounded-xl flex items-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-emerald-600 mr-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <p class="text-emerald-800 text-sm"><%= successMessage %></p>
        </div>
      <% } %>

      <% if (typeof cancelled !== 'undefined' && cancelled) { %>
        <div class="mb-6 p-4 bg-amber-50 border border-amber-200 rounded-xl flex items-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-amber-600 mr-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
          </svg>
          <p class="text-amber-800 text-sm">Booking cancelled successfully. Refund will be processed if applicable.</p>
        </div>
      <% } %>

      <% if (!bookings || bookings.length === 0) { %>
        <!-- Empty State -->
        <div class="text-center py-16">
          <h3 class="text-xl font-semibold text-gray-900 mb-2">No trips booked...yet!</h3>
          <p class="text-gray-500 text-sm mb-6">Time to dust off your bags and start planning your next adventure</p>
          <a href="/homes" class="inline-flex items-center px-5 py-2.5 bg-rose-500 hover:bg-rose-600 text-white rounded-lg font-medium text-sm transition-colors">
            Start searching
          </a>
        </div>
      <% } else { %>
        <!-- Bookings List -->
        <div class="space-y-4">
          <% bookings.forEach(function(b, index) { %>
            <% var listing = b.listingId; %>
            <%
              var now = new Date();
              var checkIn = new Date(b.checkInDate);
              var checkOut = new Date(b.checkOutDate);
              var canCancel = ['confirmed', 'pending'].includes(b.bookingStatus) && now < checkIn;
              var isUpcoming = now < checkIn && b.bookingStatus === 'confirmed';
              var isOngoing = now >= checkIn && now < checkOut && b.bookingStatus === 'confirmed';
              var isPast = now >= checkOut || b.bookingStatus === 'cancelled' || b.bookingStatus === 'completed';
              
              // Get location name
              var locationName = listing && listing.location ? listing.location.split(',')[0].trim() : 'Unknown';
            %>
            
            <div class="border border-gray-200 rounded-xl p-3 sm:p-4 hover:shadow-md transition-shadow">
              <a href="/bookings/<%= b._id %>" class="flex items-start gap-3 sm:gap-4">
                <!-- Property Image -->
                <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-lg overflow-hidden shrink-0">
                  <% if (listing && listing.photo) { %>
                    <img src="/<%= listing.photo %>" alt="<%= listing.houseName %>" class="w-full h-full object-cover"
                         onerror="this.onerror=null; this.src='/images/house1.png';">
                  <% } else { %>
                    <img src="/images/house1.png" alt="Property" class="w-full h-full object-cover">
                  <% } %>
                </div>
                
                <!-- Details -->
                <div class="flex-1 min-w-0">
                  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1 sm:gap-2 mb-1">
                    <h3 class="font-medium text-gray-900 truncate text-sm sm:text-base"><%= locationName %></h3>
                    <% if (isUpcoming) { %>
                      <span class="px-2 py-0.5 bg-blue-100 text-blue-700 text-xs font-medium rounded shrink-0">Upcoming</span>
                    <% } else if (isOngoing) { %>
                      <span class="px-2 py-0.5 bg-emerald-100 text-emerald-700 text-xs font-medium rounded shrink-0">Ongoing</span>
                    <% } else if (b.bookingStatus === 'cancelled') { %>
                      <span class="px-2 py-0.5 bg-red-100 text-red-700 text-xs font-medium rounded shrink-0">Cancelled</span>
                    <% } else if (isPast) { %>
                      <span class="px-2 py-0.5 bg-gray-100 text-gray-600 text-xs font-medium rounded shrink-0">Completed</span>
                    <% } %>
                  </div>
                  
                  <p class="text-sm text-gray-500 mb-1">
                    Hosted by <%= listing && listing.hostName ? listing.hostName : 'Host' %>
                  </p>
                  
                  <p class="text-sm text-gray-600">
                    <%= b.checkInDate.toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) %> – <%= b.checkOutDate.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                  </p>
                  
                  <!-- Price with Dynamic Pricing Indicator -->
                  <div class="flex items-center gap-2 mt-1">
                    <span class="text-sm font-medium text-gray-900">₹<%= b.totalPrice.toLocaleString('en-IN') %></span>
                    <% 
                      const origPrice = b.originalPrice || b.totalPrice;
                      const priceDiff = b.totalPrice - origPrice;
                      const hasRules = b.appliedPricingRules && b.appliedPricingRules.length > 0;
                    %>
                    <% if (hasRules && priceDiff < 0) { %>
                      <span class="px-1.5 py-0.5 bg-green-100 text-green-700 text-xs font-medium rounded">-<%= Math.abs(Math.round((priceDiff / origPrice) * 100)) %>% OFF</span>
                    <% } else if (hasRules && priceDiff > 0) { %>
                      <span class="px-1.5 py-0.5 bg-amber-100 text-amber-700 text-xs font-medium rounded">Peak Rate</span>
                    <% } %>
                  </div>
                </div>
              </a>
              
              <% if (canCancel || b.paymentStatus === 'pending') { %>
                <div class="mt-3 pt-3 border-t border-gray-100 flex gap-4">
                  <% if (canCancel) { %>
                    <a href="/bookings/<%= b._id %>/cancel" class="text-sm text-gray-700 underline hover:text-gray-900">Cancel reservation</a>
                  <% } %>
                  <% if (b.paymentStatus === 'pending' && b.bookingStatus !== 'cancelled') { %>
                    <a href="/payment/<%= b._id %>" class="text-sm text-rose-600 underline hover:text-rose-700">Complete payment</a>
                  <% } %>
                </div>
              <% } %>
            </div>
          <% }) %>
        </div>
      <% } %>
    </main>
    
    <%- include('../partials/footer') %>
  </body>
</html>
