<%- include('../partials/head') %>
  </head>
  <body class="bg-white antialiased">
    <%- include('../partials/nav') %>
    
    <main>
      <!-- Hero Section with Real Image Background -->
      <section class="relative min-h-[50vh] md:min-h-[60vh] flex items-center overflow-hidden">
        <!-- Background Image -->
        <div class="absolute inset-0">
          <img src="https://images.unsplash.com/photo-1564013799919-ab600027ffc6?auto=format&fit=crop&w=1200&q=70" 
               alt="Beautiful modern home" 
               class="w-full h-full object-cover">
          <div class="absolute inset-0 bg-gradient-to-r from-gray-900/85 via-gray-900/70 to-gray-900/40"></div>
        </div>
        
        <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
          <div class="max-w-2xl">
            <!-- Badge -->
            <div class="inline-flex items-center px-4 py-2 rounded-full bg-white/10 backdrop-blur-sm border border-white/20 text-white text-sm font-medium mb-8 scale-in">
              <span class="w-2 h-2 bg-green-400 rounded-full mr-2 animate-pulse"></span>
              Over 10,000+ verified properties
            </div>
            
            <!-- Main Heading -->
            <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white leading-[1.1] mb-4 slide-up">
              Find your
              <span class="block font-display italic text-transparent bg-clip-text bg-gradient-to-r from-rose-400 to-amber-400">
                dream stay
              </span>
            </h1>
            
            <p class="text-base md:text-lg text-white/80 mb-6 max-w-lg slide-up stagger-1">
              Experience unique accommodations hosted by locals. From urban apartments to countryside villas, your perfect escape awaits.
            </p>
            
            <!-- Search Bar - Inline Style -->
            <div class="bg-white rounded-2xl p-2 shadow-2xl max-w-2xl slide-up stagger-2">
              <form action="/search" method="GET" class="flex flex-col md:flex-row md:items-center gap-2">
                <div class="flex-1 px-4 py-3">
                  <label class="block text-xs font-semibold text-gray-500 mb-1">Location</label>
                  <input type="text" name="location" placeholder="Where are you going?" 
                         class="w-full text-gray-900 placeholder-gray-400 focus:outline-none text-sm">
                </div>
                <div class="hidden md:block w-px h-12 bg-gray-200"></div>
                <div class="flex-1 px-4 py-3">
                  <label class="block text-xs font-semibold text-gray-500 mb-1">Check in</label>
                  <input type="date" name="checkIn" 
                         class="w-full text-gray-900 focus:outline-none text-sm">
                </div>
                <div class="hidden md:block w-px h-12 bg-gray-200"></div>
                <div class="flex-1 px-4 py-3">
                  <label class="block text-xs font-semibold text-gray-500 mb-1">Check out</label>
                  <input type="date" name="checkOut" 
                         class="w-full text-gray-900 focus:outline-none text-sm">
                </div>
                <button type="submit" class="gradient-animated text-white px-8 py-4 rounded-xl font-semibold hover:shadow-lg transition-all duration-300 flex items-center justify-center gap-2 btn-glow">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                  </svg>
                  <span class="hidden md:inline">Search</span>
                </button>
              </form>
            </div>
            
            <!-- Trust Indicators -->
            <div class="flex items-center gap-6 mt-6 slide-up stagger-3">
              <div class="flex -space-x-2">
                <img src="https://randomuser.me/api/portraits/women/44.jpg" alt="User" class="w-8 h-8 rounded-full border-2 border-white">
                <img src="https://randomuser.me/api/portraits/men/32.jpg" alt="User" class="w-8 h-8 rounded-full border-2 border-white">
                <img src="https://randomuser.me/api/portraits/women/68.jpg" alt="User" class="w-8 h-8 rounded-full border-2 border-white">
                <div class="w-8 h-8 rounded-full border-2 border-white bg-rose-500 flex items-center justify-center text-white text-xs font-bold">
                  +5k
                </div>
              </div>
              <div>
                <div class="flex items-center gap-1 mb-1">
                  <% for(let i = 0; i < 5; i++) { %>
                    <svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                  <% } %>
                </div>
                <p class="text-sm text-white/70">Trusted by <span class="text-white font-semibold">50,000+</span> happy guests</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Popular Destinations -->
      <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="text-center mb-8">
          <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-2">Explore top destinations</h2>
          <p class="text-gray-500 text-sm">Discover popular places our guests love</p>
        </div>
        
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
          <a href="/search?location=Goa" class="group relative overflow-hidden rounded-xl aspect-[4/3] card-hover">
            <img src="https://images.unsplash.com/photo-1512343879784-a960bf40e7f2?auto=format&fit=crop&w=400&q=70" 
                 alt="Goa beaches" class="w-full h-full object-cover img-zoom">
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent"></div>
            <div class="absolute bottom-0 left-0 p-4">
              <h3 class="text-lg font-bold text-white">Goa</h3>
              <p class="text-white/80 text-xs">238 properties</p>
            </div>
          </a>
          
          <a href="/search?location=Mumbai" class="group relative overflow-hidden rounded-xl aspect-[4/3] card-hover">
            <img src="https://images.unsplash.com/photo-1570168007204-dfb528c6958f?auto=format&fit=crop&w=400&q=70" 
                 alt="Mumbai skyline" class="w-full h-full object-cover img-zoom">
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent"></div>
            <div class="absolute bottom-0 left-0 p-4">
              <h3 class="text-lg font-bold text-white">Mumbai</h3>
              <p class="text-white/80 text-xs">412 properties</p>
            </div>
          </a>
          
          <a href="/search?location=Jaipur" class="group relative overflow-hidden rounded-xl aspect-[4/3] card-hover">
            <img src="https://images.unsplash.com/photo-1477587458883-47145ed94245?auto=format&fit=crop&w=400&q=70" 
                 alt="Jaipur palace" class="w-full h-full object-cover img-zoom">
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent"></div>
            <div class="absolute bottom-0 left-0 p-4">
              <h3 class="text-lg font-bold text-white">Jaipur</h3>
              <p class="text-white/80 text-xs">186 properties</p>
            </div>
          </a>
          
          <a href="/search?location=Kerala" class="group relative overflow-hidden rounded-xl aspect-[4/3] card-hover">
            <img src="https://images.unsplash.com/photo-1602216056096-3b40cc0c9944?auto=format&fit=crop&w=400&q=70" 
                 alt="Kerala backwaters" class="w-full h-full object-cover img-zoom">
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent"></div>
            <div class="absolute bottom-0 left-0 p-4">
              <h3 class="text-lg font-bold text-white">Kerala</h3>
              <p class="text-white/80 text-xs">324 properties</p>
            </div>
          </a>
        </div>
      </section>

      <!-- Property Type Cards -->
      <section class="bg-gray-50 py-12">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="text-center mb-8">
            <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-2">Browse by property type</h2>
            <p class="text-gray-500 text-sm">From apartments to villas, find the perfect stay</p>
          </div>
          
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
            <% const propertyTypes = [
              { type: 'apartment', icon: '🏢', label: 'Apartments', count: '1,240', color: 'from-blue-500 to-blue-600' },
              { type: 'house', icon: '🏠', label: 'Houses', count: '890', color: 'from-emerald-500 to-emerald-600' },
              { type: 'villa', icon: '🏡', label: 'Villas', count: '456', color: 'from-purple-500 to-purple-600' },
              { type: 'cottage', icon: '🛖', label: 'Cottages', count: '234', color: 'from-orange-500 to-orange-600' },
              { type: 'cabin', icon: '🏕️', label: 'Cabins', count: '178', color: 'from-amber-500 to-amber-600' },
              { type: 'studio', icon: '🏬', label: 'Studios', count: '567', color: 'from-pink-500 to-pink-600' }
            ]; %>
            <% propertyTypes.forEach((pt, i) => { %>
              <a href="/search?propertyType=<%= pt.type %>" class="group bg-white rounded-2xl p-6 shadow-sm hover:shadow-xl transition-all duration-300 border border-gray-100 card-lift scale-in stagger-<%= i+1 %>">
                <span class="text-4xl block mb-4 group-hover:scale-110 transition-transform"><%= pt.icon %></span>
                <h3 class="font-semibold text-gray-900 mb-1"><%= pt.label %></h3>
                <p class="text-sm text-gray-500"><%= pt.count %> stays</p>
              </a>
            <% }); %>
          </div>
        </div>
      </section>
      <!-- Featured Properties -->
      <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="flex flex-col md:flex-row md:justify-between md:items-end mb-8">
          <div>
            <span class="inline-block px-3 py-1 rounded-full bg-rose-100 text-rose-600 text-xs font-medium mb-2">Featured</span>
            <h2 class="text-2xl md:text-3xl font-bold text-gray-900">Handpicked stays</h2>
            <p class="text-gray-500 text-sm mt-1">Properties loved by our guests</p>
          </div>
          <a href="/homes" class="hidden md:inline-flex items-center gap-2 px-5 py-2 mt-4 md:mt-0 rounded-full bg-gray-900 text-white hover:bg-gray-800 transition-all text-sm font-medium">
            View all
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
        
        <% if (registeredHomes.length === 0) { %>
          <div class="text-center py-12 bg-gray-50 rounded-2xl">
            <div class="w-16 h-16 bg-rose-100 rounded-xl flex items-center justify-center mx-auto mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-rose-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-2">No properties listed yet</h3>
            <p class="text-gray-500 text-sm mb-4">Be the first to share your space!</p>
            <a href="/host/add-home" class="inline-flex items-center gap-2 px-5 py-2 gradient-animated text-white rounded-full text-sm font-semibold hover:shadow-lg transition-all">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
              </svg>
              List Your Property
            </a>
          </div>
        <% } else { %>
          <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
            <% registeredHomes.slice(0, 8).forEach((home, i) => { %>
              <a href="/homes/<%= home._id %>" class="group block">
                <div class="bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-lg transition-all duration-300 border border-gray-100">
                  <!-- Image Container -->
                  <div class="relative overflow-hidden aspect-[4/3]">
                    <img src="<%= home.photo %>" alt="<%= home.houseName %>" 
                         class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                         onerror="this.src='https://images.unsplash.com/photo-1564013799919-ab600027ffc6?auto=format&fit=crop&w=400&q=70'">
                    
                    <!-- Superhost badge -->
                    <% if (home.rating >= 4.8) { %>
                      <span class="absolute top-2 left-2 px-2 py-0.5 bg-white rounded-full text-xs font-bold text-gray-900 shadow flex items-center gap-1">
                        <svg class="w-3 h-3 text-amber-500" fill="currentColor" viewBox="0 0 20 20">
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                        </svg>
                        Top
                      </span>
                    <% } else if (home.propertyType) { %>
                      <span class="absolute top-2 left-2 px-2 py-0.5 bg-white/90 backdrop-blur-sm rounded-full text-xs font-medium text-gray-700 capitalize">
                        <%= home.propertyType %>
                      </span>
                    <% } %>
                    
                    <!-- Heart button -->
                    <button class="absolute top-2 right-2 w-7 h-7 bg-white/90 backdrop-blur-sm rounded-full flex items-center justify-center shadow hover:bg-white hover:scale-110 transition-all" onclick="event.preventDefault();">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gray-600 hover:text-rose-500 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                      </svg>
                    </button>
                  </div>
                  
                  <!-- Content -->
                  <div class="p-3">
                    <div class="flex items-start justify-between mb-1">
                      <h3 class="font-medium text-gray-900 text-sm line-clamp-1 group-hover:text-rose-500 transition-colors">
                        <%= home.houseName %>
                      </h3>
                      <div class="flex items-center gap-0.5 shrink-0 ml-2">
                        <svg class="w-3 h-3 text-rose-500" fill="currentColor" viewBox="0 0 20 20">
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                        </svg>
                        <span class="text-xs font-medium text-gray-700"><%= home.rating || '4.8' %></span>
                      </div>
                    </div>
                    
                    <p class="text-gray-500 text-xs mb-2 truncate"><%= home.location %></p>
                    
                    <!-- Price -->
                    <div>
                      <span class="text-sm font-bold text-gray-900">₹<%= home.price.toLocaleString('en-IN') %></span>
                      <span class="text-gray-500 text-xs">/night</span>
                    </div>
                  </div>
                </div>
              </a>
            <% }) %>
          </div>
          
          <!-- Mobile View All -->
          <div class="md:hidden mt-6 text-center">
            <a href="/homes" class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full gradient-animated text-white text-sm font-semibold shadow-lg">
              View all properties
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        <% } %>
      </section>

      <!-- Testimonials Section -->
      <section class="bg-gray-900 py-12">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="text-center mb-8">
            <h2 class="text-2xl md:text-3xl font-bold text-white mb-2">What our guests say</h2>
            <p class="text-gray-400 text-sm">Real experiences from travelers</p>
          </div>
          
          <div class="grid md:grid-cols-3 gap-4">
            <div class="bg-gray-800/50 backdrop-blur rounded-xl p-5 border border-gray-700">
              <div class="flex items-center gap-0.5 mb-3">
                <% for(let i = 0; i < 5; i++) { %>
                  <svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                  </svg>
                <% } %>
              </div>
              <p class="text-gray-300 text-sm mb-4 leading-relaxed">"The villa exceeded expectations. Views were breathtaking!"</p>
              <div class="flex items-center gap-3">
                <img src="https://randomuser.me/api/portraits/women/45.jpg" alt="Sara" class="w-9 h-9 rounded-full object-cover">
                <div>
                  <p class="text-white text-sm font-medium">Sara Mitchell</p>
                  <p class="text-gray-500 text-xs">Goa</p>
                </div>
              </div>
            </div>
            
            <div class="bg-gray-800/50 backdrop-blur rounded-xl p-5 border border-gray-700">
              <div class="flex items-center gap-0.5 mb-3">
                <% for(let i = 0; i < 5; i++) { %>
                  <svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                  </svg>
                <% } %>
              </div>
              <p class="text-gray-300 text-sm mb-4 leading-relaxed">"Seamless booking and great pricing. Property was perfect!"</p>
              <div class="flex items-center gap-3">
                <img src="https://randomuser.me/api/portraits/men/46.jpg" alt="Raj" class="w-9 h-9 rounded-full object-cover">
                <div>
                  <p class="text-white text-sm font-medium">Raj Sharma</p>
                  <p class="text-gray-500 text-xs">Mumbai</p>
                </div>
              </div>
            </div>
            
            <div class="bg-gray-800/50 backdrop-blur rounded-xl p-5 border border-gray-700">
              <div class="flex items-center gap-0.5 mb-3">
                <% for(let i = 0; i < 5; i++) { %>
                  <svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                  </svg>
                <% } %>
              </div>
              <p class="text-gray-300 text-sm mb-4 leading-relaxed">"The cottage in Kerala was magical. Highly recommend!"</p>
              <div class="flex items-center gap-3">
                <img src="https://randomuser.me/api/portraits/women/68.jpg" alt="Priya" class="w-9 h-9 rounded-full object-cover">
                <div>
                  <p class="text-white text-sm font-medium">Priya Nair</p>
                  <p class="text-gray-500 text-xs">Kerala</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Why Choose Us -->
      <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="text-center mb-8">
          <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-2">Why book with StayBnB?</h2>
          <p class="text-gray-500 text-sm">Everything for a perfect travel experience</p>
        </div>
        
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <div class="text-center p-4 rounded-xl bg-rose-50 border border-rose-100">
            <div class="w-10 h-10 bg-rose-500 rounded-lg flex items-center justify-center mx-auto mb-3 shadow-sm">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
