<%- include('../partials/head') %>
  </head>
  <body class="bg-white antialiased">
    <!-- Clean Airbnb-style Navigation -->
    <header class="sticky top-0 z-50 bg-white border-b border-gray-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-20">
          <!-- Logo -->
          <a href="/" class="flex items-center gap-2 hover:opacity-80 transition">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 36 40" class="w-9 h-10" fill="none">
              <path d="M18 0C8.06 0 0 8.06 0 18c0 9.94 18 22 18 22s18-12.06 18-22C36 8.06 27.94 0 18 0z" fill="#FF385C"/>
              <path d="M18 8l-9 7v10h6v-6h6v6h6V15l-9-7z" fill="white"/>
              <rect x="16" y="19" width="4" height="6" rx="0.5" fill="#FF385C"/>
            </svg>
            <span class="text-xl font-bold hidden sm:block"><span class="text-rose-500">stay</span><span class="text-gray-800">bnb</span></span>
          </a>

          <!-- Search Pill -->
          <div class="hidden md:flex items-center">
            <form action="/search" method="GET" id="searchForm" class="flex items-center border border-gray-300 rounded-full shadow-sm hover:shadow-md transition-shadow">
              <!-- Location Input -->
              <div class="relative group">
                <input type="text" name="location" placeholder="Where to?" 
                  class="w-28 px-5 py-3 text-sm font-medium text-gray-800 bg-transparent rounded-l-full border-r border-gray-200 focus:outline-none focus:bg-gray-50 placeholder-gray-500">
              </div>
              <!-- Check-in Date -->
              <div class="relative group">
                <input type="date" name="checkIn" id="searchCheckIn"
                  class="w-36 px-3 py-3 text-sm font-medium text-gray-800 bg-transparent border-r border-gray-200 focus:outline-none focus:bg-gray-50"
                  title="Check-in date">
              </div>
              <!-- Check-out Date -->
              <div class="relative group">
                <input type="date" name="checkOut" id="searchCheckOut"
                  class="w-36 px-3 py-3 text-sm font-medium text-gray-800 bg-transparent border-r border-gray-200 focus:outline-none focus:bg-gray-50"
                  title="Check-out date">
              </div>
              <!-- Number of Travelers -->
              <div class="relative group">
                <select name="guests" class="px-4 py-3 text-sm text-gray-600 bg-transparent focus:outline-none focus:bg-gray-50 appearance-none cursor-pointer" title="Number of travelers">
                  <option value="">Travelers</option>
                  <option value="1">1 person</option>
                  <option value="2">2 people</option>
                  <option value="3">3 people</option>
                  <option value="4">4 people</option>
                  <option value="5">5 people</option>
                  <option value="6">6+ people</option>
                </select>
              </div>
              <button type="submit" class="p-2.5 m-1.5 bg-rose-500 hover:bg-rose-600 text-white rounded-full transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
              </button>
            </form>
          </div>

          <!-- Right Side -->
          <div class="flex items-center gap-2">
            <% if (!isLoggedIn) { %>
              <a href="/host/add-home" class="hidden md:block px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100 rounded-full transition">
                Become a host
              </a>
            <% } %>
            
            <% if (!isLoggedIn) { %>
              <a href="/login" class="flex items-center gap-2 px-3 py-2 border border-gray-300 rounded-full hover:shadow-md transition-shadow">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                </svg>
                <div class="w-8 h-8 bg-gray-500 rounded-full flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-white" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"/>
                  </svg>
                </div>
              </a>
            <% } else { %>
              <div class="relative" id="userDropdown">
                <button id="userMenuBtn" class="flex items-center gap-2 px-3 py-2 border border-gray-300 rounded-full hover:shadow-md transition-shadow">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                  </svg>
                  <div class="w-8 h-8 bg-gray-700 rounded-full flex items-center justify-center text-white text-sm font-medium">
                    <%= user.firstName ? user.firstName.charAt(0).toUpperCase() : 'U' %>
                  </div>
                </button>
                
                <div id="userMenu" class="hidden absolute right-0 mt-2 w-56 bg-white rounded-xl shadow-lg border border-gray-200 py-2 z-50">
                  <% if (user && user.userType === 'guest') { %>
                    <a href="/homes" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50">Explore</a>
                    <a href="/favourites" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50">Wishlists</a>
                    <a href="/bookings/my" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50">Trips</a>
                  <% } else { %>
                    <a href="/host/host-home-list" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50">Listings</a>
                    <a href="/host/add-home" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50">Add Listing</a>
                  <% } %>
                  <div class="border-t border-gray-100 my-1"></div>
                  <a href="/profile" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50">Account</a>
                  <form action="/logout" method="POST">
                    <button type="submit" class="w-full text-left px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50">Log out</button>
                  </form>
                </div>
              </div>
            <% } %>
          </div>
        </div>

        <!-- Mobile Search -->
        <div class="md:hidden pb-4">
          <form action="/search" method="GET" class="space-y-3">
            <!-- Main search bar -->
            <div class="flex items-center border border-gray-300 rounded-full shadow-sm p-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
              </svg>
              <input type="text" name="location" placeholder="Where to?" class="flex-1 px-3 py-1.5 text-sm text-gray-900 placeholder-gray-500 focus:outline-none">
              <button type="button" onclick="document.getElementById('mobileFilters').classList.toggle('hidden')" class="p-2 text-gray-500 hover:text-gray-700">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/>
                </svg>
              </button>
            </div>
            <!-- Expandable filters -->
            <div id="mobileFilters" class="hidden space-y-3 px-2">
              <div class="space-y-3">
                <div>
                  <label class="block text-xs text-gray-500 mb-1">Check-in Date</label>
                  <input type="date" name="checkIn" class="w-full px-4 py-2.5 text-sm border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-rose-500">
                </div>
                <div>
                  <label class="block text-xs text-gray-500 mb-1">Check-out Date</label>
                  <input type="date" name="checkOut" class="w-full px-4 py-2.5 text-sm border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-rose-500">
                </div>
              </div>
              <div>
                <label class="block text-xs text-gray-500 mb-1">Number of Travelers</label>
                <select name="guests" class="w-full px-4 py-2.5 text-sm border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-rose-500">
                  <option value="">Any number</option>
                  <option value="1">1 person</option>
                  <option value="2">2 people</option>
                  <option value="3">3 people</option>
                  <option value="4">4 people</option>
                  <option value="5">5 people</option>
                  <option value="6">6 or more</option>
                </select>
              </div>
              <button type="submit" class="w-full py-2.5 bg-rose-500 hover:bg-rose-600 text-white text-sm font-medium rounded-lg transition-colors">
                Search
              </button>
            </div>
          </form>
        </div>
      </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      
      <% if (registeredHomes.length === 0) { %>
        <!-- Empty State -->
        <div class="text-center py-20">
          <div class="w-20 h-20 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
            </svg>
          </div>
          <h2 class="text-xl font-semibold text-gray-900 mb-2">No properties listed yet</h2>
          <p class="text-gray-500 text-sm mb-6">Be the first to share your space!</p>
          <a href="/host/add-home" class="inline-flex items-center gap-2 px-6 py-3 bg-rose-500 hover:bg-rose-600 text-white rounded-lg font-medium transition-colors">
            List your property
          </a>
        </div>
      <% } else { %>

        <!-- Featured Stays Section -->
        <section class="mb-12">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-[22px] font-semibold text-gray-900">Featured stays</h2>
            <div class="flex items-center gap-2">
              <button class="w-8 h-8 flex items-center justify-center rounded-full border border-gray-300 hover:border-gray-400 bg-white disabled:opacity-40 disabled:cursor-not-allowed">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
                </svg>
              </button>
              <button class="w-8 h-8 flex items-center justify-center rounded-full border border-gray-300 hover:border-gray-400 bg-white">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                </svg>
              </button>
            </div>
          </div>
          
          <!-- Property Grid -->
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 2xl:grid-cols-6 gap-x-6 gap-y-10">
            <% registeredHomes.slice(0, 12).forEach((home, i) => { %>
              <a href="/homes/<%= home._id %>" class="group block">
                <!-- Image -->
                <div class="relative aspect-square rounded-xl overflow-hidden mb-2.5">
                  <img 
                    src="/<%= home.photo %>" 
                    alt="<%= home.houseName %>" loading="lazy" 
                    class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-300"
                    onerror="this.src='https://images.unsplash.com/photo-1564013799919-ab600027ffc6?auto=format&fit=crop&w=400&q=70'"
                    
                  >
                  
                  <!-- Guest favourite badge -->
                  <% if (home.rating && home.rating >= 4.5) { %>
                    <span class="absolute top-2.5 left-2.5 px-2 py-1 bg-white rounded-full text-xs font-medium text-gray-900 shadow-sm">
                      Guest favourite
                    </span>
                  <% } %>
                  
                  <!-- Heart/Wishlist button -->
                  <button 
                    class="absolute top-2.5 right-2.5 p-1 hover:scale-110 transition-transform" 
                    onclick="event.preventDefault();"
                    aria-label="Add to wishlist"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="rgba(0,0,0,0.5)" stroke="white" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                    </svg>
                  </button>
                </div>
                
                <!-- Property Info -->
                <div>
                  <div class="flex items-start justify-between gap-1">
                    <h3 class="font-medium text-[15px] text-gray-900 leading-snug">
                      <%= home.propertyType ? home.propertyType.charAt(0).toUpperCase() + home.propertyType.slice(1) : 'Home' %> in <%= home.location ? home.location.split(',')[0] : 'India' %>
                    </h3>
                    <% if (home.rating) { %>
                      <div class="flex items-center gap-1 shrink-0">
                        <svg class="w-3 h-3 text-gray-900" fill="currentColor" viewBox="0 0 20 20">
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                        </svg>
                        <span class="text-sm text-gray-900"><%= home.rating.toFixed(2) %></span>
                      </div>
                    <% } %>
                  </div>
                  <!-- Dynamic Pricing Display -->
                  <div class="property-pricing mt-0.5" data-listing-id="<%= home._id %>" data-base-price="<%= home.price %>">
                    <p class="text-gray-500 text-[15px]">
                      <span class="price-display">
                        <span class="font-medium text-gray-900">₹<%= home.price.toLocaleString('en-IN') %></span> for 2 nights
                      </span>
                      <span class="price-loading hidden">
                        <span class="inline-block w-16 h-4 bg-gray-200 rounded animate-pulse"></span>
                      </span>
                    </p>
                    <!-- Pricing Rule Badge -->
                    <div class="pricing-badge hidden mt-1 text-xs"></div>
                  </div>
                </div>
              </a>
            <% }); %>
          </div>
        </section>

        <!-- Homes by Location - Dynamic sections based on available data -->
        <% 
          // Group homes by location
          const locationGroups = {};
          registeredHomes.forEach(home => {
            const loc = home.location ? home.location.split(',')[0].trim() : 'Other';
            if (!locationGroups[loc]) locationGroups[loc] = [];
            locationGroups[loc].push(home);
          });
          const topLocations = Object.entries(locationGroups)
            .sort((a, b) => b[1].length - a[1].length)
            .slice(0, 3);
        %>
        
        <% topLocations.forEach(([location, homes]) => { %>
          <% if (homes.length >= 2) { %>
            <section class="mb-12">
              <div class="flex items-center justify-between mb-4">
                <div class="flex items-center gap-2">
                  <h2 class="text-[22px] font-semibold text-gray-900">Homes in <%= location %></h2>
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-900" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                  </svg>
                </div>
                <div class="flex items-center gap-2">
                  <button class="w-8 h-8 flex items-center justify-center rounded-full border border-gray-300 hover:border-gray-400 bg-white disabled:opacity-40">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
                    </svg>
                  </button>
                  <button class="w-8 h-8 flex items-center justify-center rounded-full border border-gray-300 hover:border-gray-400 bg-white">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                    </svg>
                  </button>
                </div>
              </div>
              
              <!-- Horizontal Scroll -->
              <div class="flex gap-4 overflow-x-auto pb-2 -mx-4 px-4 snap-x snap-mandatory scrollbar-hide">
                <% homes.slice(0, 8).forEach(home => { %>
                  <a href="/homes/<%= home._id %>" class="group flex-shrink-0 w-[180px] sm:w-[200px] lg:w-[220px] snap-start">
                    <div class="relative aspect-square rounded-xl overflow-hidden mb-2.5">
                      <img 
                        src="/<%= home.photo %>" 
                        alt="<%= home.houseName %>" loading="lazy" 
                        class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-300"
                        onerror="this.src='https://images.unsplash.com/photo-1564013799919-ab600027ffc6?auto=format&fit=crop&w=400&q=70'"
                        
                      >
                      
                      <% if (home.rating && home.rating >= 4.5) { %>
                        <span class="absolute top-2.5 left-2.5 px-2 py-1 bg-white rounded-full text-xs font-medium text-gray-900 shadow-sm">
                          Guest favourite
                        </span>
                      <% } %>
                      
                      <button class="absolute top-2.5 right-2.5 p-1 hover:scale-110 transition-transform" onclick="event.preventDefault();">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="rgba(0,0,0,0.5)" stroke="white" stroke-width="1.5">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                        </svg>
                      </button>
                    </div>
                    
                    <div>
                      <div class="flex items-start justify-between gap-1">
                        <h3 class="font-medium text-gray-900 text-[15px] leading-tight line-clamp-1">
                          <%= home.propertyType ? home.propertyType.charAt(0).toUpperCase() + home.propertyType.slice(1) : 'Home' %> in <%= location %>
                        </h3>
                        <% if (home.rating) { %>
                          <div class="flex items-center gap-1 shrink-0">
                            <svg class="w-3 h-3 text-gray-900" fill="currentColor" viewBox="0 0 20 20">
                              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                            </svg>
                            <span class="text-sm text-gray-900"><%= home.rating.toFixed(2) %></span>
                          </div>
                        <% } %>
                      </div>
                      <!-- Dynamic Pricing Display -->
                      <div class="property-pricing mt-0.5" data-listing-id="<%= home._id %>" data-base-price="<%= home.price %>">
                        <p class="text-gray-500 text-[15px]">
                          <span class="price-display">
                            <span class="font-medium text-gray-900">₹<%= home.price.toLocaleString('en-IN') %></span> for 2 nights
                          </span>
                          <span class="price-loading hidden">
                            <span class="inline-block w-16 h-4 bg-gray-200 rounded animate-pulse"></span>
                          </span>
                        </p>
                        <div class="pricing-badge hidden mt-1 text-xs"></div>
                      </div>
                    </div>
                  </a>
                <% }); %>
              </div>
            </section>
          <% } %>
        <% }); %>

        <!-- More Places to Stay -->
        <section class="mb-12">
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-2">
              <h2 class="text-[22px] font-semibold text-gray-900">Places to stay</h2>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-900" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
              </svg>
            </div>
            <div class="flex items-center gap-2">
              <button class="w-8 h-8 flex items-center justify-center rounded-full border border-gray-300 hover:border-gray-400 bg-white disabled:opacity-40">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
                </svg>
              </button>
              <button class="w-8 h-8 flex items-center justify-center rounded-full border border-gray-300 hover:border-gray-400 bg-white">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                </svg>
              </button>
            </div>
          </div>
          
          <div class="flex gap-4 overflow-x-auto pb-2 -mx-4 px-4 snap-x snap-mandatory scrollbar-hide">
            <% registeredHomes.slice(5, 15).forEach(home => { %>
              <a href="/homes/<%= home._id %>" class="group flex-shrink-0 w-[180px] sm:w-[200px] lg:w-[220px] snap-start">
                <div class="relative aspect-square rounded-xl overflow-hidden mb-2.5">
                  <img 
                    src="/<%= home.photo %>" 
                    alt="<%= home.houseName %>" loading="lazy" 
                    class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-300"
                    onerror="this.src='https://images.unsplash.com/photo-1564013799919-ab600027ffc6?auto=format&fit=crop&w=400&q=70'"
                    
                  >
                  
                  <% if (home.rating && home.rating >= 4.5) { %>
                    <span class="absolute top-2.5 left-2.5 px-2 py-1 bg-white rounded-full text-xs font-medium text-gray-900 shadow-sm">
                      Guest favourite
                    </span>
                  <% } %>
                  
                  <button class="absolute top-2.5 right-2.5 p-1 hover:scale-110 transition-transform" onclick="event.preventDefault();">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="rgba(0,0,0,0.5)" stroke="white" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                    </svg>
                  </button>
                </div>
                
                <div>
                  <div class="flex items-start justify-between gap-1">
                    <h3 class="font-medium text-gray-900 text-[15px] leading-tight line-clamp-1">
                      <%= home.propertyType ? home.propertyType.charAt(0).toUpperCase() + home.propertyType.slice(1) : 'Home' %> in <%= home.location ? home.location.split(',')[0] : 'India' %>
                    </h3>
                    <% if (home.rating) { %>
                      <div class="flex items-center gap-0.5 shrink-0">
                        <svg class="w-3.5 h-3.5 text-gray-900" fill="currentColor" viewBox="0 0 20 20">
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                        </svg>
                        <span class="text-sm text-gray-900"><%= home.rating.toFixed(2) %></span>
                      </div>
                    <% } %>
                  </div>
                  <!-- Dynamic Pricing Display -->
                  <div class="property-pricing mt-0.5" data-listing-id="<%= home._id %>" data-base-price="<%= home.price %>">
                    <p class="text-gray-500 text-[15px]">
                      <span class="price-display">
                        <span class="font-medium text-gray-900">₹<%= home.price.toLocaleString('en-IN') %></span> for 2 nights
                      </span>
                      <span class="price-loading hidden">
                        <span class="inline-block w-16 h-4 bg-gray-200 rounded animate-pulse"></span>
                      </span>
                    </p>
                    <div class="pricing-badge hidden mt-1 text-xs"></div>
                  </div>
                </div>
              </a>
            <% }); %>
          </div>
        </section>

      <% } %>
    </main>

    <%- include('../partials/footer') %>

    <style>
      /* Hide scrollbar but keep functionality */
      .scrollbar-hide {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }
      .scrollbar-hide::-webkit-scrollbar {
        display: none;
      }
      
      /* Line clamp for text */
      .line-clamp-1 {
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
    </style>

    <script>
      // User dropdown toggle
      const userMenuBtn = document.getElementById('userMenuBtn');
      const userMenu = document.getElementById('userMenu');
      
      if (userMenuBtn && userMenu) {
        userMenuBtn.addEventListener('click', () => {
          userMenu.classList.toggle('hidden');
        });
        
        document.addEventListener('click', (e) => {
          if (!document.getElementById('userDropdown')?.contains(e.target)) {
            userMenu.classList.add('hidden');
          }
        });
      }
      
      // ============================================
      // DYNAMIC PRICING SYSTEM
      // ============================================
      
      const searchCheckIn = document.getElementById('searchCheckIn');
      const searchCheckOut = document.getElementById('searchCheckOut');
      const propertyPricingElements = document.querySelectorAll('.property-pricing');
      
      // Pricing badge templates
      const badgeTemplates = {
        weekend: '<span class="inline-flex items-center px-1.5 py-0.5 rounded bg-amber-100 text-amber-700 mr-1"><svg class="w-3 h-3 mr-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/></svg>Weekend</span>',
        festive: '<span class="inline-flex items-center px-1.5 py-0.5 rounded bg-rose-100 text-rose-700 mr-1"><svg class="w-3 h-3 mr-0.5" fill="currentColor" viewBox="0 0 20 20"><path d="M5 2a1 1 0 011 1v1h1a1 1 0 010 2H6v1a1 1 0 01-2 0V6H3a1 1 0 010-2h1V3a1 1 0 011-1zm0 10a1 1 0 011 1v1h1a1 1 0 110 2H6v1a1 1 0 11-2 0v-1H3a1 1 0 110-2h1v-1a1 1 0 011-1z"/></svg>Festive</span>',
        offseason: '<span class="inline-flex items-center px-1.5 py-0.5 rounded bg-green-100 text-green-700 mr-1"><svg class="w-3 h-3 mr-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>Discount</span>',
      };
      
      // Format price in Indian locale
      function formatPrice(price) {
        return price.toLocaleString('en-IN');
      }
      
      // Calculate nights between dates
      function calculateNights(checkIn, checkOut) {
        const start = new Date(checkIn);
        const end = new Date(checkOut);
        return Math.ceil((end - start) / (1000 * 60 * 60 * 24));
      }
      
      // Update all property prices based on selected dates
      async function updateAllPrices() {
        const checkIn = searchCheckIn?.value;
        const checkOut = searchCheckOut?.value;
        
        if (!checkIn || !checkOut) {
          // Reset to default pricing (2 nights at base price)
          propertyPricingElements.forEach(el => {
            const basePrice = parseInt(el.dataset.basePrice);
            const priceDisplay = el.querySelector('.price-display');
            const priceBadge = el.querySelector('.pricing-badge');
            
            priceDisplay.innerHTML = `<span class="font-medium text-gray-900">₹${formatPrice(basePrice)}</span> for 2 nights`;
            priceBadge.classList.add('hidden');
            priceBadge.innerHTML = '';
          });
          return;
        }
        
        const nights = calculateNights(checkIn, checkOut);
        if (nights <= 0) return;
        
        // Show loading state
        propertyPricingElements.forEach(el => {
          el.querySelector('.price-display').classList.add('hidden');
          el.querySelector('.price-loading').classList.remove('hidden');
        });
        
        // Fetch dynamic prices for all properties
        const fetchPromises = Array.from(propertyPricingElements).map(async (el) => {
          const listingId = el.dataset.listingId;
          
          try {
            const response = await fetch(`/api/pricing/calculate?listingId=${listingId}&checkIn=${checkIn}&checkOut=${checkOut}`);
            const data = await response.json();
            
            const priceDisplay = el.querySelector('.price-display');
            const priceLoading = el.querySelector('.price-loading');
            const priceBadge = el.querySelector('.pricing-badge');
            
            // Update price display
            const originalTotal = data.originalTotal;
            const dynamicTotal = data.totalPrice;
            const hasDiscount = dynamicTotal < originalTotal;
            const hasIncrease = dynamicTotal > originalTotal;
            
            let priceHTML = '';
            if (hasDiscount) {
              priceHTML = `<span class="line-through text-gray-400 mr-1">₹${formatPrice(originalTotal)}</span><span class="font-medium text-green-600">₹${formatPrice(dynamicTotal)}</span> for ${nights} night${nights > 1 ? 's' : ''}`;
            } else if (hasIncrease) {
              priceHTML = `<span class="font-medium text-gray-900">₹${formatPrice(dynamicTotal)}</span> for ${nights} night${nights > 1 ? 's' : ''}`;
            } else {
              priceHTML = `<span class="font-medium text-gray-900">₹${formatPrice(dynamicTotal)}</span> for ${nights} night${nights > 1 ? 's' : ''}`;
            }
            
            priceDisplay.innerHTML = priceHTML;
            
            // Update pricing badges
            if (data.appliedRules && data.appliedRules.length > 0) {
              let badgesHTML = '';
              data.appliedRules.forEach(rule => {
                if (rule.type === 'WEEKEND') {
                  badgesHTML += badgeTemplates.weekend;
                } else if (rule.type === 'FESTIVE') {
                  badgesHTML += badgeTemplates.festive;
                } else if (rule.type === 'OFFSEASON') {
                  badgesHTML += badgeTemplates.offseason;
                }
              });
              priceBadge.innerHTML = badgesHTML;
              priceBadge.classList.remove('hidden');
            } else {
              priceBadge.classList.add('hidden');
              priceBadge.innerHTML = '';
            }
            
            // Hide loading, show price
            priceLoading.classList.add('hidden');
            priceDisplay.classList.remove('hidden');
            
          } catch (error) {
            console.error('Failed to fetch price for', listingId, error);
            // Fallback to base price
            const basePrice = parseInt(el.dataset.basePrice);
            const priceDisplay = el.querySelector('.price-display');
            const priceLoading = el.querySelector('.price-loading');
            
            priceDisplay.innerHTML = `<span class="font-medium text-gray-900">₹${formatPrice(basePrice * nights)}</span> for ${nights} night${nights > 1 ? 's' : ''}`;
            priceLoading.classList.add('hidden');
            priceDisplay.classList.remove('hidden');
          }
        });
        
        await Promise.all(fetchPromises);
      }
      
      // Add event listeners for date changes
      if (searchCheckIn && searchCheckOut) {
        // Set minimum dates
        const today = new Date().toISOString().split('T')[0];
        searchCheckIn.min = today;
        searchCheckOut.min = today;
        
        searchCheckIn.addEventListener('change', () => {
          // Set checkout min to day after checkin
          if (searchCheckIn.value) {
            const nextDay = new Date(searchCheckIn.value);
            nextDay.setDate(nextDay.getDate() + 1);
            searchCheckOut.min = nextDay.toISOString().split('T')[0];
            
            // If checkout is before new min, update it
            if (searchCheckOut.value && searchCheckOut.value <= searchCheckIn.value) {
              searchCheckOut.value = searchCheckOut.min;
            }
          }
          updateAllPrices();
        });
        
        searchCheckOut.addEventListener('change', updateAllPrices);
      }
    </script>
  </body>
</html>
