<%- include('../partials/head') %>
  </head>
  <body>
    <%- include('../partials/nav') %>
    <main class="container mx-auto px-4 mt-8 max-w-7xl">
      <!-- Hero Section with Quick Search -->
      <div class="bg-gradient-to-r from-red-500 to-red-600 rounded-2xl p-8 mb-8 text-white">
        <h1 class="text-4xl font-bold mb-2">Find your next stay</h1>
        <p class="text-red-100 mb-6">Search deals on hotels, homes, and much more...</p>
        
        <!-- Quick Search Form -->
        <form action="/search" method="GET" class="bg-white rounded-xl p-4 shadow-lg">
          <div class="grid grid-cols-1 md:grid-cols-5 gap-4">
            <div class="md:col-span-2">
              <label class="block text-xs font-medium text-gray-500 mb-1">Where</label>
              <input type="text" name="location" placeholder="Search destinations" 
                class="w-full text-gray-800 border-0 border-b-2 border-gray-200 focus:border-red-500 focus:ring-0 pb-1">
            </div>
            <div>
              <label class="block text-xs font-medium text-gray-500 mb-1">Check in</label>
              <input type="date" name="checkIn" min="<%= new Date().toISOString().split('T')[0] %>"
                class="w-full text-gray-800 border-0 border-b-2 border-gray-200 focus:border-red-500 focus:ring-0 pb-1">
            </div>
            <div>
              <label class="block text-xs font-medium text-gray-500 mb-1">Check out</label>
              <input type="date" name="checkOut" min="<%= new Date().toISOString().split('T')[0] %>"
                class="w-full text-gray-800 border-0 border-b-2 border-gray-200 focus:border-red-500 focus:ring-0 pb-1">
            </div>
            <div class="flex items-end">
              <button type="submit" class="w-full bg-red-500 hover:bg-red-600 text-white font-semibold py-2 px-4 rounded-lg transition flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
                Search
              </button>
            </div>
          </div>
        </form>
      </div>

      <!-- Featured Properties -->
      <div class="mb-8">
        <div class="flex justify-between items-center mb-6">
          <h2 class="text-2xl font-bold text-gray-800">Featured Properties</h2>
          <a href="/homes" class="text-red-500 hover:text-red-600 font-medium flex items-center">
            View all
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
        
        <% if (registeredHomes.length === 0) { %>
          <div class="text-center py-12 bg-gray-50 rounded-lg">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mx-auto text-gray-400 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
            <h3 class="text-xl font-semibold text-gray-600 mb-2">No properties available yet</h3>
            <p class="text-gray-500">Check back later for amazing stays!</p>
          </div>
        <% } else { %>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            <% registeredHomes.slice(0, 8).forEach(home => { %>
              <a href="/homes/<%= home._id %>" class="group">
                <div class="bg-white rounded-xl shadow-sm overflow-hidden hover:shadow-lg transition duration-300 border border-gray-100">
                  <div class="relative">
                    <img src="<%= home.photo %>" alt="<%= home.houseName %>" class="w-full h-48 object-cover group-hover:scale-105 transition duration-300">
                    <% if (home.propertyType) { %>
                      <span class="absolute top-3 left-3 bg-white/90 backdrop-blur-sm px-2 py-1 rounded-md text-xs font-medium text-gray-700 capitalize">
                        <%= home.propertyType %>
                      </span>
                    <% } %>
                  </div>
                  <div class="p-4">
                    <div class="flex justify-between items-start mb-1">
                      <h3 class="font-semibold text-gray-800 line-clamp-1 group-hover:text-red-500 transition"><%= home.houseName %></h3>
                      <div class="flex items-center shrink-0 ml-2">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 text-yellow-400">
                          <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.433 2.082-5.006z" clip-rule="evenodd" />
                        </svg>
                        <span class="text-sm text-gray-600 ml-1"><%= home.rating %></span>
                      </div>
                    </div>
                    <p class="text-gray-500 text-sm mb-2 flex items-center">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                      </svg>
                      <%= home.location %>
                    </p>
                    <% if (home.maxGuests || home.bedrooms) { %>
                      <p class="text-gray-400 text-xs mb-2">
                        <% if (home.maxGuests) { %><%= home.maxGuests %> guests<% } %>
                        <% if (home.maxGuests && home.bedrooms) { %> · <% } %>
                        <% if (home.bedrooms) { %><%= home.bedrooms %> bed<% } %>
                        <% if (home.bathrooms) { %> · <%= home.bathrooms %> bath<% } %>
                      </p>
                    <% } %>
                    <div class="flex justify-between items-center pt-2 border-t border-gray-100">
                      <div>
                        <span class="font-bold text-gray-800">₹<%= home.price.toLocaleString('en-IN') %></span>
                        <span class="text-gray-500 text-sm"> / night</span>
                      </div>
                    </div>
                  </div>
                </div>
              </a>
            <% }) %>
          </div>
        <% } %>
      </div>

      <!-- Browse by Property Type -->
      <div class="mb-8">
        <h2 class="text-2xl font-bold text-gray-800 mb-6">Browse by property type</h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-4">
          <% const propertyTypes = [
            { type: 'apartment', icon: '🏢', label: 'Apartments' },
            { type: 'house', icon: '🏠', label: 'Houses' },
            { type: 'villa', icon: '🏡', label: 'Villas' },
            { type: 'cottage', icon: '🛖', label: 'Cottages' },
            { type: 'cabin', icon: '🏕️', label: 'Cabins' },
            { type: 'studio', icon: '🏬', label: 'Studios' }
          ]; %>
          <% propertyTypes.forEach(pt => { %>
            <a href="/search?propertyType=<%= pt.type %>" class="bg-gray-50 hover:bg-gray-100 rounded-xl p-4 text-center transition group">
              <span class="text-3xl block mb-2"><%= pt.icon %></span>
              <span class="text-sm font-medium text-gray-700 group-hover:text-red-500"><%= pt.label %></span>
            </a>
          <% }); %>
        </div>
      </div>
    </main>
  </body>
</html>
