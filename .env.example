# Environment Variables for Airbnb Application

# MongoDB Connection String
# Local MongoDB: mongodb://localhost:27017/airbnb
# MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/airbnb?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/airbnb

# Use in-memory MongoDB for development (set to 'true' to enable)
# Note: Data is not persisted with this option
USE_MEMORY_DB=false

# Session Secret (change in production)
SESSION_SECRET=your-secret-key-change-in-production

# Server Port
PORT=3003

# Payment Configuration
# Set to 'false' to disable payment and allow direct booking (for testing)
# Set to 'true' to require payment before confirming bookings
PAYMENT_ENABLED=false

# Razorpay Payment Gateway Configuration
# Get your keys from https://dashboard.razorpay.com/app/keys
# Use test keys for development, live keys for production
RAZORPAY_KEY_ID=rzp_test_yourkeyid
RAZORPAY_KEY_SECRET=yourkeysecret

# RabbitMQ Configuration (for email queue)
# Install RabbitMQ: https://www.rabbitmq.com/download.html
# Or use CloudAMQP: https://www.cloudamqp.com/
RABBITMQ_URL=amqp://localhost

# Email Configuration (SMTP)
# For Gmail: Enable "Less secure app access" or use App Passwords
# For production: Use services like SendGrid, Mailgun, AWS SES
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# App URL (for email links)
APP_URL=http://localhost:8090
